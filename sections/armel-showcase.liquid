{%- comment -%}
  Armel products: centred two-line title + signature, then a sideways rail of rounded product tiles.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}

<div
  class="a-showcase a-scope a-showcase--{{ section.settings.image_fit }}"
  id="a-products"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }}; --a-tile: {{ section.settings.tile }};"
>
  <header class="a-showcase__head">
    <h2 class="a-showcase__title">
      <span data-a-reveal="blur">{{ section.settings.heading | escape }}</span>
      {%- if section.settings.heading_2 != blank -%}
        <span data-a-reveal="blur" style="--a-delay: 90ms;">{{ section.settings.heading_2 | escape }}</span>
      {%- endif -%}
    </h2>
    {%- if section.settings.show_signature -%}
      <span
        class="a-sig a-showcase__sig"
        role="img"
        aria-label="by Aneta &amp; Marína"
        data-a-reveal="scale"
        style="-webkit-mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}'); mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}'); --a-delay: 160ms;"
      ></span>
    {%- endif -%}
  </header>

  <div class="a-rail" data-a-rail>
    <ul class="a-rail__track" role="list" data-a-rail-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li class="a-rail__item" data-a-reveal="scale" style="--a-delay: {{ forloop.index0 | at_most: 4 | times: 80 }}ms;">
            {%- render 'armel-product-card', product: product -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <li class="a-rail__item" data-a-reveal="scale" style="--a-delay: {{ forloop.index0 | at_most: 4 | times: 80 }}ms;">
            <a class="a-card" href="{{ routes.all_products_collection_url }}">
              <div class="a-card__media">
                {{ 'product-' | append: i | placeholder_svg_tag: 'a-card__placeholder' }}
              </div>
              <div class="a-card__meta">
                <span class="a-card__title">Název produktu</span>
                <span class="a-card__price">1 490 Kč</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>

  <div class="a-showcase__foot" data-a-reveal style="--a-delay: 120ms;">
    <div class="a-rail__nav" data-a-rail-nav hidden>
      <button class="a-icon-btn" type="button" data-a-rail-prev aria-label="Předchozí produkty">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="a-icon-btn" type="button" data-a-rail-next aria-label="Další produkty">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="a-link" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
        {{- section.settings.link_label | escape -}}
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Armel – produkty",
  "tag": "section",
  "class": "a-section a-section--showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis – 1. řádek", "default": "Unikátní kousky z italské kůže" },
    { "type": "text", "id": "heading_2", "label": "Nadpis – 2. řádek", "default": "S láskou ručně ušité na Moravě" },
    { "type": "checkbox", "id": "show_signature", "label": "Podpis „by Aneta & Marína“", "default": true },
    { "type": "collection", "id": "collection", "label": "Kolekce" },
    { "type": "range", "id": "limit", "label": "Počet produktů", "min": 3, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Fotky produktů",
      "default": "contain",
      "options": [
        { "value": "contain", "label": "Celý produkt na světlém podkladu" },
        { "value": "cover", "label": "Vyplnit celou kartu" }
      ]
    },
    { "type": "text", "id": "link_label", "label": "Text odkazu", "default": "Celá kolekce" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "tile", "label": "Podklad karet", "default": "#F1F0EE" },
    { "type": "color", "id": "text", "label": "Text", "default": "#EFEDEA" }
  ],
  "presets": [{ "name": "Armel – produkty" }]
}
{% endschema %}
