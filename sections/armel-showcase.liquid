{%- comment -%}
  Armel products: heading + a rail of product cards from one collection.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}

<div
  class="a-showcase a-scope"
  id="a-products"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};"
>
  <header class="a-showcase__head">
    <h2 class="a-h2" data-a-reveal>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="a-showcase__intro" data-a-reveal style="--a-delay: 80ms;">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
  </header>

  <div class="a-rail">
    <ul class="a-rail__track" role="list" aria-label="{{ section.settings.heading | escape }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li class="a-rail__item" data-a-reveal style="--a-delay: {{ forloop.index0 | at_most: 4 | times: 70 }}ms;">
            {%- render 'armel-product-card', product: product -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <li class="a-rail__item" data-a-reveal style="--a-delay: {{ forloop.index0 | times: 70 }}ms;">
            <a class="a-card" href="{{ routes.all_products_collection_url }}">
              <div class="a-card__media">
                {{ 'product-' | append: i | placeholder_svg_tag: 'a-card__placeholder' }}
              </div>
              <div class="a-card__meta">
                <span class="a-card__title">Název produktu</span>
                <span class="a-card__price">1 490 Kč</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <li class="a-rail__item a-rail__more" data-a-reveal>
          <a class="a-rail__more-link" href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
            <span>{{ section.settings.link_label | escape }}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>

</div>

{% schema %}
{
  "name": "Armel – produkty",
  "tag": "section",
  "class": "a-section a-section--showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Aktuální kousky" },
    { "type": "textarea", "id": "intro", "label": "Text", "default": "Každý existuje jen jednou. Až se prodá, další bude z jiného kusu kůže a s jinými fleky." },
    { "type": "collection", "id": "collection", "label": "Kolekce" },
    { "type": "range", "id": "limit", "label": "Počet produktů", "min": 3, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Text odkazu", "default": "Celá kolekce" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "text", "label": "Text", "default": "#EFEDEA" }
  ],
  "presets": [{ "name": "Armel – produkty" }]
}
{% endschema %}
