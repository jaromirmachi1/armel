{%- comment -%}
  Armel showcase: brand intro (eyebrow, headline, signature) + product rail.
  Products come from the chosen collection; without one, placeholder cards show.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}

<div
  class="a-showcase a-scope"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};"
>
  <header class="a-showcase__head" data-a-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="a-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="a-showcase__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.show_signature -%}
      <img
        class="a-signature"
        src="{{ 'by-aneta-marina-black.png' | asset_url }}"
        alt="by Aneta &amp; Marína"
        width="1524"
        height="274"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
  </header>

  <div class="a-rail" data-a-rail>
    <ul class="a-rail__track" role="list" data-a-rail-track tabindex="0" aria-label="{{ section.settings.heading | default: 'Produkty' | escape }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li class="a-rail__item">
            {%- render 'armel-product-card', product: product -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="a-rail__item">
            <a class="a-card" href="{{ routes.all_products_collection_url }}">
              <div class="a-card__media a-card__media--placeholder">
                {{ 'product-' | append: i | placeholder_svg_tag: 'a-card__placeholder' }}
              </div>
              <div class="a-card__meta">
                <span class="a-card__title">Název produktu</span>
                <span class="a-card__price">1 490 Kč</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>

  <div class="a-showcase__foot">
    <div class="a-rail__nav" data-a-rail-nav hidden>
      <button class="a-icon-btn" type="button" data-a-rail-prev aria-label="Předchozí">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="a-icon-btn" type="button" data-a-rail-next aria-label="Další">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a
        class="a-link"
        href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
      >
        {{- section.settings.link_label | escape -}}
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Armel – produkty",
  "tag": "section",
  "class": "a-section a-section--showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadpis malý", "default": "Unikátní kousky z italské kůže" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "S láskou ručně ušité na Moravě" },
    { "type": "checkbox", "id": "show_signature", "label": "Zobrazit podpis „by Aneta & Marína“", "default": true },
    { "type": "collection", "id": "collection", "label": "Kolekce" },
    { "type": "range", "id": "limit", "label": "Počet produktů", "min": 3, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Text odkazu", "default": "Zobrazit vše" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "text", "label": "Text", "default": "#F6F1EC" }
  ],
  "presets": [{ "name": "Armel – produkty" }]
}
{% endschema %}
