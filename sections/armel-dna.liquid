{%- comment -%}
  Armel DNA: full about page — brand story, values, and optional Shopify page body.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

<section class="a-dna a-scope" style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};">
  <div class="a-dna__intro">
    <h1 class="a-dna__title" data-a-reveal="blur">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.lead != blank -%}
      <p class="a-dna__lead" data-a-reveal style="--a-delay: 90ms;">{{ section.settings.lead | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if section.settings.credit != blank -%}
      <p class="a-dna__credit" data-a-reveal style="--a-delay: 120ms;">{{ section.settings.credit | escape }}</p>
    {%- endif -%}
  </div>

  <div class="a-dna__grid">
    <div class="a-dna__copy" data-a-reveal="left" style="--a-delay: 120ms;">
      <h2 class="a-dna__sub">{{ section.settings.sub_1 | escape }}</h2>
      <p>{{ section.settings.text_1 | escape }}</p>
    </div>
    <div class="a-dna__copy" data-a-reveal="right" style="--a-delay: 180ms;">
      <h2 class="a-dna__sub">{{ section.settings.sub_2 | escape }}</h2>
      <p>{{ section.settings.text_2 | escape }}</p>
    </div>
    <div class="a-dna__copy" data-a-reveal="left" style="--a-delay: 220ms;">
      <h2 class="a-dna__sub">{{ section.settings.sub_3 | escape }}</h2>
      <p>{{ section.settings.text_3 | escape }}</p>
    </div>
    <div class="a-dna__copy" data-a-reveal="right" style="--a-delay: 260ms;">
      <h2 class="a-dna__sub">{{ section.settings.sub_4 | escape }}</h2>
      <p>{{ section.settings.text_4 | escape }}</p>
    </div>
  </div>

  <figure class="a-dna__figure" data-a-reveal="clip" style="--a-delay: 160ms;">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw',
          loading: 'lazy',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      <img
        src="{{ 'armel-clutch-closed.jpg' | asset_url }}"
        alt="Zavřené psaníčko Armel z kůže se srstí"
        width="1800"
        height="1221"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <figcaption>{{ section.settings.caption | escape }}</figcaption>
    {%- endif -%}
  </figure>

  {%- if page.content != blank -%}
    <div class="a-dna__body rte" data-a-reveal>{{ page.content }}</div>
  {%- endif -%}

  <span
    class="a-sig a-dna__sig"
    role="img"
    aria-label="by Aneta &amp; Marína"
    style="-webkit-mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}'); mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}');"
    data-a-reveal="scale"
  ></span>
</section>

{% schema %}
{
  "name": "Armel – DNA",
  "tag": "section",
  "class": "a-section a-section--dna",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "DNA" },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Úvod",
      "default": "ARMEL vznikl z našeho dlouholetého přátelství a společné vášně pro kreativitu. S láskou navrhujeme a vlastnoručně šijeme unikátní kožené doplňky. Za každým kouskem stojí hodiny ruční práce a kus našeho srdce. Od výběru materiálu až po poslední steh je všechno v našich rukách."
    },
    { "type": "text", "id": "credit", "label": "Podpis pod úvodem", "default": "– Aneta & Marína" },
    { "type": "text", "id": "sub_1", "label": "Podnadpis 1", "default": "Italská prémiová kůže" },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Text 1",
      "default": "Pracujeme výhradně s vysoce kvalitní italskou kůží. Vybíráme ji pro její jedinečné vlastnosti a odolnost, díky které vám naše kousky budou dělat radost dlouhé roky. S úctou k materiálu aktivně zpracováváme i zbytkové usně a zachraňujeme odřezky, které by bez povšimnutí skončily jako odpad. Věříme, že opravdová udržitelnost spočívá v poctivém zpracování a ohleduplnosti ke zdrojům."
    },
    { "type": "text", "id": "sub_2", "label": "Podnadpis 2", "default": "Ruční výroba" },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Text 2",
      "default": "Žádná sériová výroba ani pásová linka. Všechny doplňky vlastnoručně navrhujeme, řežeme a šijeme od prvního do posledního stehu samy dvě."
    },
    { "type": "text", "id": "sub_3", "label": "Podnadpis 3", "default": "Doma na Moravě" },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Text 3",
      "default": "Všechno vzniká u nás na Moravě v České republice – s úctou k lokálnímu řemeslu a naší planetě."
    },
    { "type": "text", "id": "sub_4", "label": "Podnadpis 4", "default": "originALITA" },
    {
      "type": "textarea",
      "id": "text_4",
      "label": "Text 4",
      "default": "Díky vlastnoručnímu zpracování a přírodnímu charakteru prémiové kůže je každý kousek unikátní. Drobné nuance a nepravidelnosti kůže nejsou vadou, ale pečetí originality."
    },
    { "type": "image_picker", "id": "image", "label": "Fotka" },
    { "type": "text", "id": "caption", "label": "Popisek fotky", "default": "Ručně šité detaily z naší dílny" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#EFEDEA" },
    { "type": "color", "id": "text", "label": "Text", "default": "#4B1D1E" }
  ],
  "presets": [{ "name": "Armel – DNA" }]
}
{% endschema %}
