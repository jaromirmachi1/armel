{%- comment -%}
  Newsletter unsubscribe page. Not linked in the storefront — only from email footers.
  Submits a Shopify contact form so the request lands in Admin → Inbox.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}
{{ 'armel-unsubscribe.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign contact_email = section.settings.email | default: 'info@armelhouse.com'
-%}

<section class="a-unsub a-scope" style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};">
  <div class="a-unsub__inner">
    <header class="a-unsub__head">
      <h1 class="a-unsub__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="a-unsub__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- form 'contact', id: 'ArmelUnsubscribe', class: 'a-unsub__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter-unsubscribe">
      <input type="hidden" name="contact[subject]" value="{{ section.settings.subject | escape }}">

      {%- if form.posted_successfully? -%}
        <p class="a-unsub__success" role="status" tabindex="-1">
          {{ section.settings.success | escape }}
        </p>
      {%- else -%}
        <div class="a-unsub__field">
          <label class="visually-hidden" for="ArmelUnsubEmail-{{ section.id }}">
            {{ 'blocks.email_signup.label' | t }}
          </label>
          <input
            id="ArmelUnsubEmail-{{ section.id }}"
            class="a-unsub__input"
            type="email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% endif %}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ArmelUnsubError-{{ section.id }}"
            {% endif %}
          >
          <button class="a-unsub__submit" type="submit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>

        <textarea
          class="visually-hidden"
          name="contact[body]"
          tabindex="-1"
          aria-hidden="true"
        >{{ section.settings.body_prefix | escape }}</textarea>

        {%- if form.errors -%}
          <p id="ArmelUnsubError-{{ section.id }}" class="a-unsub__error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <p class="a-unsub__note">
      {{ section.settings.note | escape }}
      <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Armel – odhlášení",
  "tag": "section",
  "class": "a-section a-section--unsubscribe",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Odhlášení z newsletteru"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Úvod",
      "default": "Zadejte e-mail, na který dostáváte novinky z dílny. Odhlásíme vás co nejdřív."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Váš e-mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Tlačítko",
      "default": "Odhlásit"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Potvrzení",
      "default": "Hotovo. Tento e-mail už od nás novinky nedostane."
    },
    {
      "type": "text",
      "id": "subject",
      "label": "Předmět zprávy do schránky",
      "default": "Odhlášení z newsletteru"
    },
    {
      "type": "text",
      "id": "body_prefix",
      "label": "Text zprávy",
      "default": "Prosím o odhlášení tohoto e-mailu z Armel newsletteru."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Poznámka pod formulářem",
      "default": "Něco nefunguje? Napište nám na"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Kontaktní e-mail",
      "default": "info@armelhouse.com"
    },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#EFEDEA" },
    { "type": "color", "id": "text", "label": "Text", "default": "#4B1D1E" }
  ],
  "presets": [{ "name": "Armel – odhlášení" }]
}
{% endschema %}
