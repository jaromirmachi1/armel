{%- comment -%}
  Armel gallery strip: a row of square photographs above the footer.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- liquid
  assign ig_home = section.settings.handle_link | default: 'https://www.instagram.com/armelhouse/'
-%}

<section
  class="a-strip a-scope"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};"
  aria-label="{{ 'armel.gallery' | t }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="visually-hidden">{% render 'armel-line', key: 'gallery', text: section.settings.heading %}</h2>
  {%- endif -%}

  <ul class="a-strip__track" role="list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign post_url = block.settings.link | default: ig_home -%}
        <li class="a-strip__item" data-a-reveal style="--a-delay: {{ forloop.index0 | times: 50 }}ms;" {{ block.shopify_attributes }}>
          <a
            class="a-strip__link"
            href="{{ post_url }}"
            target="_blank"
            rel="noopener"
            {% if block.settings.caption != blank %}
              aria-label="{{ block.settings.caption | escape }}"
            {% else %}
              aria-label="{{ 'armel.gallery' | t }}"
            {% endif %}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 900px) 18vw, 42vw',
                  loading: 'lazy',
                  alt: block.settings.caption
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- render 'armel-ig-posts', view: 'strip', limit: 5 -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Armel – galerie",
  "tag": "section",
  "class": "a-section a-section--gallery",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis (skrytý)", "default": "Galerie" },
    { "type": "url", "id": "handle_link", "label": "Odkaz fotek (Instagram)" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "text", "label": "Text", "default": "#EFEDEA" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Fotka",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotka" },
        { "type": "text", "id": "caption", "label": "Popisek", "default": "Psaníčko pod paží" },
        { "type": "url", "id": "link", "label": "Odkaz" }
      ]
    }
  ],
  "presets": [{ "name": "Armel – galerie" }]
}
{% endschema %}
