{%- comment -%}
  Armel gallery: endless photo strip. Pauses on hover; static and scrollable with reduced motion.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- capture tiles -%}
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <li class="a-gallery__tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- assign tile_alt = block.settings.image.alt | default: '' -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 750px) 22vw, 60vw',
              loading: 'lazy',
              alt: tile_alt
          }}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..3) -%}
      <li class="a-gallery__tile">
        <img src="{{ 'armel-strip-' | append: i | append: '.jpg' | asset_url }}" alt="" width="274" height="275" loading="lazy" decoding="async">
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="a-gallery a-scope"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }}; --a-speed: {{ section.settings.speed }}s;"
  data-a-gallery
>
  {%- if section.settings.heading != blank -%}
    <div class="a-gallery__head" data-a-reveal>
      <h2 class="a-eyebrow">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.handle != blank -%}
        <a class="a-link" href="{{ section.settings.handle_link | default: 'https://www.instagram.com/' }}" target="_blank" rel="noopener">
          {{- section.settings.handle | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="a-gallery__viewport">
    <ul class="a-gallery__track" role="list">
      {{ tiles }}
      {{ tiles | replace: '<li class="a-gallery__tile"', '<li aria-hidden="true" class="a-gallery__tile"' }}
      {{ tiles | replace: '<li class="a-gallery__tile"', '<li aria-hidden="true" class="a-gallery__tile"' }}
      {{ tiles | replace: '<li class="a-gallery__tile"', '<li aria-hidden="true" class="a-gallery__tile"' }}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Armel – galerie",
  "tag": "section",
  "class": "a-section a-section--gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Armel na těle" },
    { "type": "text", "id": "handle", "label": "Instagram text", "default": "Instagram" },
    { "type": "url", "id": "handle_link", "label": "Instagram odkaz" },
    { "type": "range", "id": "speed", "label": "Rychlost (sekund na kolo)", "min": 20, "max": 120, "step": 5, "default": 45 },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "text", "label": "Text", "default": "#F6F1EC" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Fotka",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotka" },
        { "type": "url", "id": "link", "label": "Odkaz" }
      ]
    }
  ],
  "presets": [{ "name": "Armel – galerie" }]
}
{% endschema %}
