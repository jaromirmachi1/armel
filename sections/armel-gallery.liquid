{%- comment -%}
  Armel gallery: one frame stays put while its photographs crossfade.
  Tap or Enter advances; reduced motion holds the first picture.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

<div
  class="a-gallery a-scope"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};"
>
  <div class="a-gallery__text">
    <h2 class="a-h2" data-a-reveal="left">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="a-gallery__intro" data-a-reveal style="--a-delay: 90ms;">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    {%- if section.settings.handle != blank -%}
      <a class="a-link" href="{{ section.settings.handle_link | default: 'https://www.instagram.com/' }}" target="_blank" rel="noopener" data-a-reveal="scale" style="--a-delay: 160ms;">
        {{- section.settings.handle | escape -}}
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </div>

  <figure class="a-frame" data-a-frame data-a-reveal="clip" style="--a-delay: 120ms;">
    <button class="a-frame__stage" type="button" data-a-frame-next aria-label="Další fotka">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <span class="a-frame__slide{% if forloop.first %} is-on{% endif %}" data-caption="{{ block.settings.caption | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '450, 700, 900', sizes: '(min-width: 750px) 34vw, 76vw', loading: 'lazy', alt: block.settings.caption }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      {%- else -%}
        {%- assign defaults = 'armel-sq-rivets.jpg|Nýty na klopě, zblízka;armel-strip-1.jpg|Přívěsky na karabinách;armel-sq-suede.jpg|Klopa zevnitř, broušená kůže;armel-strip-2.jpg|Psaníčko pod paží;armel-strip-3.jpg|Bílá, zebra, koňak' | split: ';' -%}
        {%- for d in defaults -%}
          {%- assign parts = d | split: '|' -%}
          <span class="a-frame__slide{% if forloop.first %} is-on{% endif %}" data-caption="{{ parts[1] }}">
            <img src="{{ parts[0] | asset_url }}" alt="{{ parts[1] }}" width="900" height="900" loading="lazy" decoding="async">
          </span>
        {%- endfor -%}
      {%- endif -%}
    </button>
    <figcaption class="a-frame__caption" data-a-frame-caption aria-live="polite">
      {%- if section.blocks.size > 0 -%}{{ section.blocks.first.settings.caption | escape }}{%- else -%}Nýty na klopě, zblízka{%- endif -%}
    </figcaption>
  </figure>
</div>

{% schema %}
{
  "name": "Armel – galerie",
  "tag": "section",
  "class": "a-section a-section--gallery",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Jak se armel nosí" },
    { "type": "textarea", "id": "intro", "label": "Text", "default": "Na klíčích, v ruce, pod paží. Fotky z našeho stolu i z ulice." },
    { "type": "text", "id": "handle", "label": "Instagram text", "default": "Instagram" },
    { "type": "url", "id": "handle_link", "label": "Instagram odkaz" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "text", "label": "Text", "default": "#EFEDEA" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Fotka",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotka" },
        { "type": "text", "id": "caption", "label": "Popisek", "default": "Psaníčko pod paží" }
      ]
    }
  ],
  "presets": [{ "name": "Armel – galerie" }]
}
{% endschema %}
