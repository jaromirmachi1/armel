{%- render 'armel-home-assets' -%}
{{ 'armel-hero.css' | asset_url | stylesheet_tag }}

<div class="armel-hero" data-armel-hero>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        class: 'armel-hero__photo',
        alt: section.settings.image_alt,
        fetchpriority: 'high',
        loading: 'eager'
    }}
  {%- else -%}
    <img
      class="armel-hero__photo"
      src="{{ 'ArmelHero.png' | asset_url }}"
      alt="{{ section.settings.image_alt | escape }}"
      width="1367"
      height="833"
      fetchpriority="high"
      decoding="async"
    >
  {%- endif -%}

  {% render 'armel-bar', links: section.blocks, is_home: true, bar_id: section.id %}

  <div class="armel-hero__intro">
    <h1 class="armel-hero__title" data-a-reveal="blur">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="armel-hero__text" data-a-reveal style="--a-delay: 100ms;">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="a-btn" href="{{ section.settings.button_link | default: '#a-products' }}" data-a-reveal="scale" style="--a-delay: 180ms;">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_signature -%}
    <span class="a-sig armel-hero__sig" role="img" aria-label="by Aneta &amp; Marína" style="-webkit-mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}'); mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}');"></span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Armel hero",
  "tag": "section",
  "class": "armel-hero-section",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Leave empty to use the Armel hero photograph in theme assets."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description",
      "default": "Ručně šitá pouzdra Armel z kůže a kožešiny, zavěšená na kovových kroužcích"
    },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Kožené doplňky šité ručně na Moravě" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pouzdra a psaníčka z italské kůže se srstí a stříbrnými nýty. Každý kus je jiný, šijeme je samy dvě." },
    { "type": "text", "id": "button_label", "label": "Tlačítko", "default": "Prohlédnout kousky" },
    { "type": "url", "id": "button_link", "label": "Odkaz tlačítka" },
    { "type": "checkbox", "id": "show_signature", "label": "Podpis „by Aneta & Marína“", "default": false }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Kolekce"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Armel hero",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Kolekce",
            "link": "/collections"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Produkty",
            "link": "/collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "O nás",
            "link": "/pages/o-nas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
