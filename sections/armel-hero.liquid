{{ 'armel-hero.css' | asset_url | stylesheet_tag }}

<div class="armel-hero" data-armel-hero>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        class: 'armel-hero__photo',
        alt: section.settings.image_alt,
        fetchpriority: 'high',
        loading: 'eager'
    }}
  {%- else -%}
    <img
      class="armel-hero__photo"
      src="{{ 'ArmelHero.png' | asset_url }}"
      alt="{{ section.settings.image_alt | escape }}"
      width="1367"
      height="833"
      fetchpriority="high"
      decoding="async"
    >
  {%- endif -%}

  <header class="armel-hero__bar">
    <div class="armel-hero__start">
      <button
        class="armel-hero__toggle"
        type="button"
        data-armel-toggle
        aria-expanded="false"
        aria-controls="ArmelNav-{{ section.id }}"
        aria-label="{{ 'accessibility.menu' | t }}"
        data-open-label="{{ 'accessibility.menu' | t }}"
        data-close-label="{{ 'accessibility.close_dialog' | t }}"
      >
        <span class="armel-hero__toggle-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>

      <nav
        id="ArmelNav-{{ section.id }}"
        class="armel-hero__nav"
        data-armel-nav
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
      >
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
          </a>
        {%- endfor -%}
      </nav>
    </div>

    <h1 class="armel-hero__mark">
      <a
        href="{{ routes.root_url }}"
        aria-current="page"
      >
        <img
          class="armel-hero__logo"
          src="{{ 'armel-logo.png' | asset_url }}"
          alt="{{ 'accessibility.home_logo_alt' | t: store_name: shop.name }}"
          width="240"
          height="77"
          decoding="async"
        >
      </a>
    </h1>

    <div class="armel-hero__tools">
      {%- if localization.available_countries.size > 1 -%}
        {% form 'localization', class: 'armel-hero__locale-form' %}
          <label class="visually-hidden" for="ArmelCountry-{{ section.id }}">
            {{ 'accessibility.country_region' | t }}
          </label>
          <select
            id="ArmelCountry-{{ section.id }}"
            class="armel-hero__locale-select"
            name="country_code"
            onchange="this.form.submit()"
          >
            {%- for country in localization.available_countries -%}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}
                  selected
                {% endif %}
              >
                {{ country.iso_code }}
              </option>
            {%- endfor -%}
          </select>
        {% endform %}
      {%- else -%}
        <span class="armel-hero__locale">{{ localization.country.iso_code | default: 'CZ' }}</span>
      {%- endif -%}

      <a
        class="armel-hero__icon-btn"
        href="{{ routes.account_url }}"
        aria-label="{{ 'accessibility.account' | t }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <circle cx="8" cy="5.15" r="2.15" stroke="currentColor" stroke-width="1.15"/>
          <path d="M3.15 13.15c.72-2.25 2.45-3.35 4.85-3.35s4.13 1.1 4.85 3.35" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
        </svg>
      </a>

      {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
        <button
          class="armel-hero__icon-btn"
          type="button"
          on:click="#cart-drawer/toggle"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="cart-drawer"
          aria-label="{{ 'accessibility.cart' | t }}"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
            <path d="M4.15 6.15h7.7v7.15H4.15V6.15Z" stroke="currentColor" stroke-width="1.15"/>
            <path d="M6.15 6.15V4.9a1.85 1.85 0 0 1 3.7 0v1.25" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="armel-hero__count">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
          </span>
        </button>
      {%- else -%}
        <a
          class="armel-hero__icon-btn"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'accessibility.cart' | t }}"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
            <path d="M4.15 6.15h7.7v7.15H4.15V6.15Z" stroke="currentColor" stroke-width="1.15"/>
            <path d="M6.15 6.15V4.9a1.85 1.85 0 0 1 3.7 0v1.25" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="armel-hero__count">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
          </span>
        </a>
      {%- endif -%}
    </div>
  </header>

  <div class="armel-hero__line" aria-hidden="true"></div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) root = document.querySelector('[data-armel-hero]');
    if (!root) return;
    var button = root.querySelector('[data-armel-toggle]');
    var nav = root.querySelector('[data-armel-nav]');
    if (!button || !nav) return;

    function setOpen(open) {
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) nav.setAttribute('data-open', 'true');
      else nav.removeAttribute('data-open');
      button.setAttribute('aria-label', open ? button.getAttribute('data-close-label') : button.getAttribute('data-open-label'));
    }

    button.addEventListener('click', function () {
      var open = button.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) {
        var first = nav.querySelector('a');
        if (first) first.focus();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    nav.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });
  })();
</script>

{% schema %}
{
  "name": "Armel hero",
  "tag": "section",
  "class": "armel-hero-section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "Leave empty to use the Armel hero photograph in theme assets."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description",
      "default": "Ručně šitá pouzdra Armel z kůže a kožešiny, zavěšená na kovových kroužcích"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Kolekce"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Armel hero",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Kolekce",
            "link": "/collections"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Produkty",
            "link": "/collections/all"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "O nás",
            "link": "/pages/o-nas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
