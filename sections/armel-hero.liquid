{%- render 'armel-home-assets' -%}
{{ 'armel-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_alt = section.settings.image_alt
  assign use_video = section.settings.enable_video
  assign cta_label = section.settings.button_label
  assign cta_link = section.settings.button_link | default: routes.all_products_collection_url
  if section.settings.image != blank
    assign poster_url = section.settings.image | image_url: width: 2400
  else
    assign poster_url = 'armel-hero-poster.jpg' | asset_url
  endif
-%}

<div class="armel-hero" data-armel-hero{% if use_video %} data-armel-hero-video{% endif %}>
  {%- if use_video -%}
    <video
      class="armel-hero__photo armel-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="{{ poster_url }}"
      aria-hidden="true"
    >
      <source src="{{ 'armel-hero.mp4' | asset_url }}" type="video/mp4">
    </video>
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'armel-hero__photo armel-hero__photo--fallback',
          alt: '',
          loading: 'eager'
      }}
    {%- else -%}
      <img
        class="armel-hero__photo armel-hero__photo--fallback"
        src="{{ poster_url }}"
        alt=""
        width="1280"
        height="720"
        decoding="async"
      >
    {%- endif -%}
  {%- elsif section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        class: 'armel-hero__photo',
        alt: hero_alt,
        fetchpriority: 'high',
        loading: 'eager'
    }}
  {%- else -%}
    <img
      class="armel-hero__photo"
      src="{{ 'ArmelHero.png' | asset_url }}"
      alt="{{ hero_alt | escape }}"
      width="1367"
      height="833"
      fetchpriority="high"
      decoding="async"
    >
  {%- endif -%}

  {% render 'armel-bar', links: section.blocks, is_home: true, bar_id: section.id %}

  <div class="armel-hero__copy">
    <h1 class="armel-hero__title">
      {%- if section.settings.heading != blank -%}
        <span class="armel-hero__line">{{ section.settings.heading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <span class="armel-hero__line">{{ section.settings.text | escape }}</span>
      {%- endif -%}
    </h1>
    {%- if cta_label != blank -%}
      <a class="armel-hero__cta" href="{{ cta_link }}">{{ cta_label | escape }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_signature -%}
    <span class="a-sig armel-hero__sig" role="img" aria-label="by Aneta &amp; Marína" style="-webkit-mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}'); mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}');"></span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Armel hero",
  "tag": "section",
  "class": "armel-hero-section",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_video",
      "label": "Použít hero video",
      "info": "Místo fotky přehraje ztlumené video z tématu (armel-hero.mp4). Při reduced motion zůstane poster.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph / poster",
      "info": "Poster pro video a záloha, když je video vypnuté. Prázdné = vestavěný poster / ArmelHero.png."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description",
      "default": "Ručně šitá pouzdra Armel z kůže a kožešiny, zavěšená na kovových kroužcích"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Řádek 1",
      "default": "Unikátní kousky z italské kůže"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Řádek 2",
      "default": "S láskou ručně ušité na Moravě"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Tlačítko",
      "default": "Nová kolekce"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Odkaz tlačítka",
      "info": "Prázdné = celá kolekce"
    },
    { "type": "checkbox", "id": "show_signature", "label": "Podpis „by Aneta & Marína“", "default": false }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Produkty"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Armel hero",
      "blocks": [
        { "type": "link", "settings": { "label": "Produkty", "link": "/collections/all" } },
        { "type": "link", "settings": { "label": "DNA", "link": "/pages/dna" } },
        { "type": "link", "settings": { "label": "Galerie", "link": "/pages/galerie" } }
      ]
    }
  ]
}
{% endschema %}
