{%- comment -%}
  Armel newsletter: one word on the left, the clutch invitation on the right.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}
{{ 'armel-newsletter.css' | asset_url | stylesheet_tag }}

<section
  class="a-invite a-scope"
  style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};"
  aria-labelledby="ArmelInvite-{{ section.id }}"
>
  <h2 class="a-invite__title" id="ArmelInvite-{{ section.id }}" data-a-reveal="left">
    {%- render 'armel-line', key: 'invite.heading', text: section.settings.heading -%}
  </h2>

  <div class="armel-newsletter-section a-invite__stage">
    <div class="armel-newsletter" data-armel-newsletter>
      <div
        class="armel-clutch"
        id="ArmelClutch-{{ section.id }}"
        data-armel-clutch
        aria-expanded="false"
        aria-label="{% render 'armel-line', key: 'invite.aria', text: section.settings.aria_label %}"
      >
        <div class="armel-clutch__flap" aria-hidden="true">
          <img
            class="armel-clutch__flap-outside"
            src="{{ 'clutch-flap-outside.webp' | asset_url }}"
            alt=""
            width="1600"
            height="500"
            decoding="async"
          >
          <img
            class="armel-clutch__flap-inside"
            src="{{ 'clutch-flap-inside.webp' | asset_url }}"
            alt=""
            width="1600"
            height="500"
            decoding="async"
          >
        </div>

        <div class="armel-clutch__letter">
          <p class="armel-clutch__letter-title">{% render 'armel-line', key: 'invite.letter', text: section.settings.letter_title %}</p>
          {%- if section.settings.copy != blank -%}
            <p class="armel-clutch__letter-copy">{% render 'armel-line', key: 'invite.copy', text: section.settings.copy %}</p>
          {%- endif -%}

          <img
            class="armel-clutch__signature"
            src="{{ 'by-aneta-marina-black.png' | asset_url }}"
            alt="by Aneta Marina"
            width="1524"
            height="274"
            decoding="async"
          >

          {%- form 'customer', class: 'armel-clutch__form', id: 'ArmelInviteForm' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,armel-invite">

            {%- if form.posted_successfully? -%}
              <p
                class="armel-clutch__message armel-clutch__message--success"
                role="status"
                data-armel-form-success
                tabindex="-1"
              >
                {% render 'armel-line', key: 'invite.success', text: section.settings.success_message %}
              </p>
            {%- else -%}
              <div class="armel-clutch__field">
                <label class="visually-hidden" for="ArmelEmail-{{ section.id }}">
                  {{ 'blocks.email_signup.label' | t }}
                </label>
                <input
                  id="ArmelEmail-{{ section.id }}"
                  class="armel-clutch__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{% render 'armel-line', key: 'invite.placeholder', text: section.settings.placeholder %}"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="ArmelEmailError-{{ section.id }}"
                  {% endif %}
                >
                <button class="armel-clutch__submit" type="submit">
                  {% render 'armel-line', key: 'invite.button', text: section.settings.button_label %}
                </button>
              </div>

              {%- if form.errors -%}
                <p
                  id="ArmelEmailError-{{ section.id }}"
                  class="armel-clutch__message armel-clutch__message--error"
                  role="alert"
                  data-armel-form-error
                >
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>

        <img
          class="armel-clutch__body"
          src="{{ 'clutch-body.webp' | asset_url }}"
          alt=""
          width="1600"
          height="980"
          decoding="async"
          loading="lazy"
        >
      </div>
    </div>
  </div>
</section>

<script src="{{ 'armel-newsletter.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Armel – pozvánka",
  "tag": "section",
  "class": "a-section a-section--invite",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Newsletter" },
    { "type": "text", "id": "letter_title", "label": "Text na dopisu", "default": "Pozvánka" },
    { "type": "text", "id": "copy", "label": "Text dopisu", "default": "Přednostní přístup k dalšímu dropu" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Tvůj e-mail" },
    { "type": "text", "id": "button_label", "label": "Tlačítko", "default": "Přihlásit" },
    { "type": "text", "id": "success_message", "label": "Potvrzení", "default": "Jsi na seznamu." },
    { "type": "text", "id": "aria_label", "label": "Popis pro čtečky", "default": "Otevřít pozvánku a přihlásit se k odběru" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#7D3031" },
    { "type": "color", "id": "text", "label": "Text", "default": "#EFEDEA" }
  ],
  "presets": [{ "name": "Armel – pozvánka" }]
}
{% endschema %}
