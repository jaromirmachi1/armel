{%- comment -%}
  Armel Galerie: Instagram-linked photo grid. Each image click-through opens the post.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- liquid
  assign ig_home = section.settings.handle_link | default: 'https://www.instagram.com/armelhouse/'
-%}

<section class="a-ig a-scope" style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};">
  <header class="a-ig__head">
    <h1 class="a-ig__title">{% render 'armel-line', key: 'gallery', text: section.settings.heading | default: page.title %}</h1>
  </header>

  <ul class="a-ig__grid" role="list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign post_url = block.settings.link | default: ig_home -%}
        <li class="a-ig__item" data-a-reveal style="--a-delay: {{ forloop.index0 | times: 60 }}ms;" {{ block.shopify_attributes }}>
          <a
            class="a-ig__card"
            href="{{ post_url }}"
            target="_blank"
            rel="noopener"
            {% if block.settings.caption != blank %}
              aria-label="{{ block.settings.caption | escape }} — Instagram"
            {% else %}
              aria-label="{{ 'armel.ig.open' | t }}"
            {% endif %}
          >
            <span class="a-ig__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    widths: '400, 600, 900',
                    sizes: '(min-width: 900px) 25vw, (min-width: 600px) 33vw, 50vw',
                    loading: 'lazy',
                    alt: block.settings.caption
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- render 'armel-ig-posts', view: 'grid', limit: 12 -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Armel – Galerie Instagram",
  "tag": "section",
  "class": "a-section a-section--ig",
  "enabled_on": {
    "templates": ["page", "index"]
  },
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Galerie" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Text",
      "default": "Jak se Armel nosí — fotky z dílny i z ulice. Kliknutím otevřete příspěvek na Instagramu."
    },
    { "type": "text", "id": "handle", "label": "Instagram text", "default": "@armelhouse" },
    { "type": "url", "id": "handle_link", "label": "Instagram profil" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#EFEDEA" },
    { "type": "color", "id": "text", "label": "Text", "default": "#4B1D1E" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Fotka",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotka" },
        { "type": "text", "id": "caption", "label": "Popisek", "default": "Armel na Instagramu" },
        {
          "type": "url",
          "id": "link",
          "label": "Odkaz na Instagram příspěvek",
          "info": "Po kliknutí se otevře tento odkaz. Když je prázdný, použije se profil."
        }
      ]
    }
  ],
  "presets": [{ "name": "Armel – Galerie Instagram" }]
}
{% endschema %}
