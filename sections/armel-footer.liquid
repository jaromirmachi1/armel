{%- render 'armel-home-assets' -%}

<footer class="a-footer a-scope">
  <div class="a-footer__top">
    <h2 class="visually-hidden">Patička</h2>
    <div class="a-footer__cols">
      {%- for block in section.blocks -%}
        <nav class="a-footer__col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }} data-a-reveal style="--a-delay: {{ forloop.index0 | times: 70 }}ms;">
          <h3 class="a-footer__col-title">{{ block.settings.title | escape }}</h3>
          {%- if block.type == 'menu' -%}
            <ul role="list">
              {%- assign has_returns = false -%}
              {%- for link in linklists[block.settings.menu].links -%}
                {%- if link.url contains section.settings.returns_url -%}{%- assign has_returns = true -%}{%- endif -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
              {%- if block.settings.menu == 'footer' and section.settings.show_returns and has_returns == false -%}
                <li><a href="{{ section.settings.returns_url }}">{{ section.settings.returns_label | escape }}</a></li>
              {%- endif -%}
            </ul>
          {%- else -%}
            <div class="a-footer__rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </nav>
      {%- else -%}
        <nav class="a-footer__col" aria-label="Obchod" data-a-reveal>
          <h3 class="a-footer__col-title">Obchod</h3>
          <ul role="list">
            {%- for link in linklists['main-menu'].links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
        <nav class="a-footer__col" aria-label="Informace" data-a-reveal style="--a-delay: 70ms;">
          <h3 class="a-footer__col-title">Informace</h3>
          <ul role="list">
            {%- assign has_returns = false -%}
            {%- for link in linklists.footer.links -%}
              {%- if link.url contains section.settings.returns_url -%}{%- assign has_returns = true -%}{%- endif -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
            {%- if section.settings.show_returns and has_returns == false -%}
              <li><a href="{{ section.settings.returns_url }}">{{ section.settings.returns_label | escape }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
        <div class="a-footer__col" data-a-reveal style="--a-delay: 140ms;">
          <h3 class="a-footer__col-title">Kontakt</h3>
          <div class="a-footer__rte"><p><a href="mailto:thearmel.info@gmail.com">thearmel.info@gmail.com</a></p></div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="a-footer__bottom" data-a-reveal="scale" style="--a-delay: 120ms;">
    <a class="a-footer__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <img src="{{ 'armel-logo-silver.png' | asset_url }}" alt="" width="1078" height="346" loading="lazy" decoding="async">
    </a>
    <p class="a-footer__legal">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal | default: shop.name | escape }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Armel – patička",
  "tag": "section",
  "class": "a-section a-section--footer",
  "settings": [
    { "type": "text", "id": "legal", "label": "Copyright text", "default": "armel · by Aneta & Marína · ručně šito na Moravě" },
    { "type": "checkbox", "id": "show_returns", "label": "Odkaz na Vrácení ve sloupci Informace", "info": "Přidá se jen tehdy, když už není v menu patičky.", "default": true },
    { "type": "text", "id": "returns_label", "label": "Text odkazu", "default": "Vrácení a reklamace" },
    { "type": "text", "id": "returns_url", "label": "Adresa stránky", "default": "/pages/vraceni" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Obchod" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>thearmel.info@gmail.com</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Armel – patička",
      "blocks": [
        { "type": "menu", "settings": { "title": "Obchod", "menu": "main-menu" } },
        { "type": "menu", "settings": { "title": "Informace", "menu": "footer" } },
        { "type": "text", "settings": { "title": "Kontakt" } }
      ]
    }
  ]
}
{% endschema %}
