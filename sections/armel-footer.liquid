{%- comment -%}
  Armel footer: the last photograph, darkened, with the links on top and the silver name across the bottom.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

<footer class="a-footer a-scope">
  <div class="a-footer__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', loading: 'lazy', alt: '' }}
    {%- else -%}
      <img src="{{ 'armel-floor.jpg' | asset_url }}" alt="" width="2400" height="1888" loading="lazy" decoding="async">
    {%- endif -%}
  </div>

  <div class="a-footer__top">
    <h2 class="visually-hidden">Patička</h2>
    <div class="a-footer__cols">
      {%- for block in section.blocks -%}
        <nav class="a-footer__col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          <h3 class="a-footer__col-title">{{ block.settings.title | escape }}</h3>
          {%- if block.type == 'menu' -%}
            <ul role="list">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="a-footer__rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </nav>
      {%- else -%}
        <nav class="a-footer__col" aria-label="Obchod">
          <h3 class="a-footer__col-title">Obchod</h3>
          <ul role="list">
            {%- for link in linklists['main-menu'].links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
        <nav class="a-footer__col" aria-label="Informace">
          <h3 class="a-footer__col-title">Informace</h3>
          <ul role="list">
            {%- for link in linklists.footer.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
        <div class="a-footer__col">
          <h3 class="a-footer__col-title">Kontakt</h3>
          <div class="a-footer__rte"><p><a href="mailto:thearmel.info@gmail.com">thearmel.info@gmail.com</a></p></div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="a-footer__bottom">
    <a class="a-footer__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <img src="{{ 'armel-logo-silver.png' | asset_url }}" alt="" width="1078" height="346" loading="lazy" decoding="async">
    </a>
    <p class="a-footer__legal">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal | default: shop.name | escape }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Armel – patička",
  "tag": "section",
  "class": "a-section a-section--footer",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fotka na pozadí" },
    { "type": "text", "id": "legal", "label": "Copyright text", "default": "armel · by Aneta & Marína · ručně šito na Moravě" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Obchod" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>thearmel.info@gmail.com</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Armel – patička",
      "blocks": [
        { "type": "menu", "settings": { "title": "Obchod", "menu": "main-menu" } },
        { "type": "menu", "settings": { "title": "Informace", "menu": "footer" } },
        { "type": "text", "settings": { "title": "Kontakt" } }
      ]
    }
  ]
}
{% endschema %}
