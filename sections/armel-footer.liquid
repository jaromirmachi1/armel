{%- comment -%}
  Armel footer, used on every page (homepage via index.json, other pages via layout/theme.liquid).
  Top: a short line + newsletter (or a contact link). Middle: link columns, accordions on phones.
  Bottom: the silver wordmark, then legal, policies, payment icons and a back-to-top link.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- liquid
  assign s = section.settings
  assign contact_email = s.email | default: 'info@armelhouse.com'
  assign sig = 'by-aneta-marina-black.png' | asset_url
-%}

<footer class="a-footer a-scope" data-a-footer>
  <h2 class="visually-hidden">Patička</h2>

  <div class="a-footer__top">
    <div class="a-footer__intro" data-a-reveal>
      <p class="a-footer__heading">{{ s.heading | escape }}</p>
      <span class="a-sig a-footer__sig" role="img" aria-label="Aneta &amp; Marína" style="-webkit-mask-image: url('{{ sig }}'); mask-image: url('{{ sig }}');"></span>
    </div>

    <div class="a-footer__news" data-a-reveal style="--a-delay: 80ms;">
      {%- if s.show_newsletter -%}
        {{ 'armel-newsletter.css' | asset_url | stylesheet_tag }}
        <div class="armel-newsletter-section a-footer__clutch">
          <div class="armel-newsletter" data-armel-newsletter>
            <div
              class="armel-clutch"
              id="ArmelFooterClutch-{{ section.id }}"
              data-armel-clutch
              aria-expanded="false"
              aria-label="{{ s.news_title | escape }}"
            >
              <div class="armel-clutch__flap" aria-hidden="true">
                <img class="armel-clutch__flap-outside" src="{{ 'clutch-flap-outside.webp' | asset_url }}" alt="" width="1600" height="500" decoding="async">
                <img class="armel-clutch__flap-inside" src="{{ 'clutch-flap-inside.webp' | asset_url }}" alt="" width="1600" height="500" decoding="async">
              </div>
              <div class="armel-clutch__letter">
                <p class="armel-clutch__letter-title">{{ s.news_title | escape }}</p>
                {%- if s.news_note != blank -%}
                  <p class="armel-clutch__letter-copy">{{ s.news_note | escape }}</p>
                {%- endif -%}
                {%- form 'customer', class: 'armel-clutch__form', id: 'ArmelFooterNews' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter,armel-footer">
                  {%- if form.posted_successfully? -%}
                    <p class="armel-clutch__message armel-clutch__message--success" role="status" data-armel-form-success tabindex="-1">
                      {{ s.news_success | escape }}
                    </p>
                  {%- else -%}
                    <div class="armel-clutch__field">
                      <label class="visually-hidden" for="ArmelFootEmail-{{ section.id }}">E-mail</label>
                      <input
                        id="ArmelFootEmail-{{ section.id }}"
                        class="armel-clutch__input"
                        type="email"
                        name="contact[email]"
                        value="{{ form.email }}"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        placeholder="Váš e-mail"
                        required
                        {% if form.errors %}
                          aria-invalid="true"
                          aria-describedby="ArmelFootEmailError-{{ section.id }}"
                        {% endif %}
                      >
                      <button class="armel-clutch__submit" type="submit">Odebírat</button>
                    </div>
                    {%- if form.errors -%}
                      <p id="ArmelFootEmailError-{{ section.id }}" class="armel-clutch__message armel-clutch__message--error" role="alert" data-armel-form-error>
                        {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                      </p>
                    {%- endif -%}
                  {%- endif -%}
                {%- endform -%}
              </div>
              <img class="armel-clutch__body" src="{{ 'clutch-body.webp' | asset_url }}" alt="" width="1600" height="980" decoding="async" loading="lazy">
            </div>
          </div>
        </div>
        <script src="{{ 'armel-newsletter.js' | asset_url }}" defer></script>
      {%- else -%}
        <p class="a-footer__label">{{ s.contact_title | escape }}</p>
        <a class="a-footer__big-link" href="mailto:{{ contact_email }}">
          <span>{{ contact_email }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="a-footer__cols">
    {%- for block in section.blocks -%}
      <details class="a-footer__col" open {{ block.shopify_attributes }} data-a-reveal style="--a-delay: {{ forloop.index0 | times: 60 }}ms;">
        <summary class="a-footer__col-title">{{ block.settings.title | escape }}<span class="a-footer__plus" aria-hidden="true"></span></summary>
        {%- if block.type == 'menu' -%}
          <ul class="a-footer__list" role="list">
            {%- assign has_returns = false -%}
            {%- for link in linklists[block.settings.menu].links -%}
              {%- if link.url contains s.returns_url -%}{%- assign has_returns = true -%}{%- endif -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
            {%- if block.settings.menu == 'footer' and s.show_returns and has_returns == false -%}
              <li><a href="{{ s.returns_url }}">{{ s.returns_label | escape }}</a></li>
            {%- endif -%}
          </ul>
        {%- else -%}
          {%- assign contact_title_down = block.settings.title | downcase -%}
          {%- if contact_title_down == 'kontakt' or contact_title_down == 'contact' -%}
            <ul class="a-footer__list" role="list">
              <li><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></li>
              {%- if s.place != blank -%}<li><span>{{ s.place | escape }}</span></li>{%- endif -%}
              {%- if s.owner != blank -%}
                {%- assign owner_parts = s.owner | split: ' · ' -%}
                {%- for part in owner_parts -%}
                  <li><span>{{ part | escape }}</span></li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          {%- else -%}
            <div class="a-footer__list a-footer__rte">{{ block.settings.text }}</div>
          {%- endif -%}
        {%- endif -%}
      </details>
    {%- else -%}
      <details class="a-footer__col" open data-a-reveal>
        <summary class="a-footer__col-title">Obchod<span class="a-footer__plus" aria-hidden="true"></span></summary>
        <ul class="a-footer__list" role="list">
          {%- for link in linklists['main-menu'].links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </details>
      <details class="a-footer__col" open data-a-reveal style="--a-delay: 60ms;">
        <summary class="a-footer__col-title">Informace<span class="a-footer__plus" aria-hidden="true"></span></summary>
        <ul class="a-footer__list" role="list">
          {%- assign has_returns = false -%}
          {%- for link in linklists.footer.links -%}
            {%- if link.url contains s.returns_url -%}{%- assign has_returns = true -%}{%- endif -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
          {%- if s.show_returns and has_returns == false -%}
            <li><a href="{{ s.returns_url }}">{{ s.returns_label | escape }}</a></li>
          {%- endif -%}
        </ul>
      </details>
      <details class="a-footer__col" open data-a-reveal style="--a-delay: 120ms;">
        <summary class="a-footer__col-title">Kontakt<span class="a-footer__plus" aria-hidden="true"></span></summary>
        <ul class="a-footer__list" role="list">
          <li><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></li>
          {%- if s.place != blank -%}<li><span>{{ s.place | escape }}</span></li>{%- endif -%}
          {%- if s.owner != blank -%}
            {%- assign owner_parts = s.owner | split: ' · ' -%}
            {%- for part in owner_parts -%}
              <li><span>{{ part | escape }}</span></li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </details>
    {%- endfor -%}

    {%- if s.instagram_url != blank -%}
      <details class="a-footer__col" open data-a-reveal style="--a-delay: 180ms;">
        <summary class="a-footer__col-title">Sledujte nás<span class="a-footer__plus" aria-hidden="true"></span></summary>
        <ul class="a-footer__list" role="list">
          <li><a href="{{ s.instagram_url }}" target="_blank" rel="noopener">Instagram</a></li>
          {%- if s.tiktok_url != blank -%}<li><a href="{{ s.tiktok_url }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
        </ul>
      </details>
    {%- endif -%}
  </div>

  <div class="a-footer__bottom">
    <a class="a-footer__mark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}" data-a-reveal="mark">
      <img src="{{ 'armel-logo-silver.png' | asset_url }}" alt="" width="1080" height="312" loading="lazy" decoding="async">
    </a>

    <div class="a-footer__legal">
      <p class="a-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ s.legal | default: shop.name | escape }}</p>

      {%- assign policies = shop.policies -%}
      {%- if policies.size > 0 -%}
        <ul class="a-footer__policies" role="list">
          {%- for policy in policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="a-footer__pay" role="list" aria-label="Platební metody">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <a class="a-footer__top-link" href="#" data-a-to-top>
        Nahoru
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5m-5 5 5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Armel – patička",
  "tag": "section",
  "class": "a-section a-section--footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Věta nahoře", "default": "Kožené doplňky šité ručně na Moravě, kus po kusu." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Zobrazit přihlášení k newsletteru", "info": "Na úvodní stránce je vypnuté, protože newsletter je hned nad patičkou. Místo něj se ukáže e-mail.", "default": true },
    { "type": "text", "id": "news_title", "label": "Nadpis", "default": "Novinky z dílny jako první" },
    { "type": "text", "id": "news_note", "label": "Poznámka pod polem", "default": "Nové kousky a malé série, žádný spam. Odhlásit se můžete kdykoli." },
    { "type": "text", "id": "news_success", "label": "Zpráva po přihlášení", "default": "Děkujeme, jste na seznamu." },
    { "type": "text", "id": "contact_title", "label": "Nadpis kontaktu (když je newsletter vypnutý)", "default": "Napište nám" },
    { "type": "header", "content": "Kontakt a sítě" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "info@armelhouse.com" },
    { "type": "text", "id": "place", "label": "Místo", "default": "Brno, Česká republika" },
    { "type": "text", "id": "owner", "label": "Provozovatel", "info": "Oddělte části znakem · — každá se ukáže na vlastním řádku pod kontaktem.", "default": "Aneta Janoudová · IČO 17074576 · Edisonova 3117/11, Brno" },
    { "type": "text", "id": "instagram_url", "label": "Instagram (celá adresa)", "default": "https://www.instagram.com/armelhouse/" },
    { "type": "text", "id": "tiktok_url", "label": "TikTok (celá adresa)" },
    { "type": "header", "content": "Spodní řádek" },
    { "type": "text", "id": "legal", "label": "Copyright text", "default": "armel · by Aneta & Marína" },
    { "type": "checkbox", "id": "show_payment", "label": "Ikony platebních metod", "default": true },
    { "type": "checkbox", "id": "show_returns", "label": "Odkaz na Vrácení ve sloupci Informace", "info": "Přidá se jen tehdy, když už není v menu patičky.", "default": true },
    { "type": "text", "id": "returns_label", "label": "Text odkazu", "default": "Vrácení a reklamace" },
    { "type": "text", "id": "returns_url", "label": "Adresa stránky", "default": "/pages/vraceni" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Obchod" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>info@armelhouse.com</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Armel – patička",
      "blocks": [
        { "type": "menu", "settings": { "title": "Obchod", "menu": "main-menu" } },
        { "type": "menu", "settings": { "title": "Informace", "menu": "footer" } },
        { "type": "text", "settings": { "title": "Kontakt" } }
      ]
    }
  ]
}
{% endschema %}
