{%- comment -%}
  Armel material: one photograph inside a rivet-round shape, cropped by the left edge,
  beside short points about what the piece is made of. Each point is marked with a rivet.
{%- endcomment -%}
{%- render 'armel-home-assets' -%}

{%- capture default_points -%}
Italská kůže se srstí|Hovězí kůže z Itálie, vybraná pro odolnost. Srst je hladká a fleky má každý kus jinde.
Broušená kůže uvnitř|Klopa je zevnitř z jemné šedé broušené kůže, která se na dotek podobá semišu.
Stříbrné nýty|Okraje i klopu drží pohromadě řada kovových nýtů. Jsou vidět a mají být vidět.
Odřezky nevyhazujeme|Zpracováváme i zbytkové usně a odřezky, které by bez povšimnutí skončily jako odpad.
Každý kus jiný|Drobné nepravidelnosti kůže nejsou vada, ale pečeť originality.
Doma na Moravě|Všechno vzniká u nás na Moravě, s úctou k lokálnímu řemeslu a k naší planetě.
{%- endcapture -%}

<div class="a-material a-scope" style="--a-bg: {{ section.settings.background }}; --a-fg: {{ section.settings.text }};">
  <h2 class="a-h2 a-material__heading" data-a-reveal>{{ section.settings.heading | escape }}</h2>

  <div class="a-material__shape" data-a-reveal>
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 46vw, 82vw', loading: 'lazy', alt: section.settings.image.alt }}
    {%- else -%}
      <img src="{{ 'armel-clutch-open.jpg' | asset_url }}" alt="Otevřené psaníčko: šedá broušená kůže na klopě, kůže se srstí a nýty po okraji" width="1800" height="1589" loading="lazy" decoding="async">
    {%- endif -%}
  </div>

  <div class="a-material__body">
    <ul class="a-material__list" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="a-material__item" {{ block.shopify_attributes }} data-a-reveal style="--a-delay: {{ forloop.index0 | times: 70 }}ms;">
            <h3 class="a-material__title"><span class="a-rivet" aria-hidden="true"></span>{{ block.settings.title | escape }}</h3>
            <p class="a-material__text">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign lines = default_points | strip | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}
          {%- assign parts = line | strip | split: '|' -%}
          <li class="a-material__item" data-a-reveal style="--a-delay: {{ forloop.index0 | times: 70 }}ms;">
            <h3 class="a-material__title"><span class="a-rivet" aria-hidden="true"></span>{{ parts[0] }}</h3>
            <p class="a-material__text">{{ parts[1] }}</p>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Armel – materiál",
  "tag": "section",
  "class": "a-section a-section--material",
  "max_blocks": 9,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fotka v kruhu" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Z čeho je armel" },
    { "type": "color", "id": "background", "label": "Pozadí", "default": "#EFEDEA" },
    { "type": "color", "id": "text", "label": "Text", "default": "#3A1516" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bod",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Italská kůže se srstí" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hovězí kůže z Itálie, vybraná pro odolnost." }
      ]
    }
  ],
  "presets": [{ "name": "Armel – materiál" }]
}
{% endschema %}
