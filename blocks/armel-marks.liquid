<ul class="armel-marks" aria-label="{{ 'armel.marks' | t }}" {{ block.shopify_attributes }}>
  <li class="armel-marks__item">{{ 'armel.mark_hand' | t }}</li>
  <li class="armel-marks__item">{{ 'armel.mark_moravia' | t }}</li>
  <li class="armel-marks__item">{{ 'armel.mark_leather' | t }}</li>
</ul>

{% stylesheet %}
  .armel-marks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 8px;
    margin: 0;
    padding: 2px 2px 8px;
    list-style: none;
  }

  .armel-marks__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #f6f1e8;
    color: #7d3031;
    font-family: var(--font-body--family), Montserrat, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid rgb(125 48 49 / 0.22);
  }

  @media screen and (min-width: 750px) {
    .armel-marks__item:nth-child(1) {
      transform: rotate(-2deg);
    }

    .armel-marks__item:nth-child(2) {
      transform: rotate(1.5deg) translateY(5px);
    }

    .armel-marks__item:nth-child(3) {
      transform: rotate(-0.8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .armel-marks__item {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Armel marks",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Armel marks"
    }
  ]
}
{% endschema %}
