{%- comment -%}
  Products page with one tag filter. Never a /collections/handle address.
  {% render 'armel-filter-href', tag: 'obaly-na-denik' %}
{%- endcomment -%}
{%- liquid
  assign wanted_tag = tag | strip
  assign found = routes.all_products_collection_url
  if wanted_tag != blank
    assign found = found | append: '?filter.p.tag=' | append: wanted_tag
  endif
  echo found
-%}
