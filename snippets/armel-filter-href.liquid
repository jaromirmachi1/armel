{%- comment -%}
  Opens the catalog on one category.
  A real collection is used only when it actually has products.
  Otherwise the link is the catalog plus the Shopify tag, which is a real page.
  {% render 'armel-filter-href', handle: 'doplnky', tag: 'obaly-na-balzam' %}
{%- endcomment -%}
{%- liquid
  assign wanted_handle = handle | strip
  assign wanted_tag = tag | strip
  assign wanted = collections[wanted_handle]
  assign found = ''

  if wanted_handle != blank and wanted.products_count > 0 and wanted.url != blank
    assign found = wanted.url
  endif

  if found == blank and wanted_tag != blank
    assign found = routes.all_products_collection_url | append: '/' | append: wanted_tag
  endif

  if found == blank
    assign found = routes.all_products_collection_url
  endif
-%}
{%- capture localized -%}{%- render 'armel-href', path: found -%}{%- endcapture -%}
{{- localized | strip -}}
