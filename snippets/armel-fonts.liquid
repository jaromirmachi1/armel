{%- comment -%}
  Armel type rules. One place decides the fonts for the whole storefront:
  - headline font (Theme settings → Armel – písmo a pohyb → Písmo nadpisů)
  - navigation case (Theme settings → Armel – písmo a pohyb → Menu velkými písmeny)
  Every Armel section reads these variables: --a-display*, --armel-nav-*.
{%- endcomment -%}
{%- liquid
  assign armel_display = settings.armel_display_font | default: 'sans'
  assign armel_nav_upper = true
  if settings.armel_nav_uppercase == false
    assign armel_nav_upper = false
  endif
-%}
<style>
  @font-face {
    font-family: 'Armel Script';
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'armel-script-latin-ext.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+20A0-20C0, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Armel Script';
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'armel-script-latin.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212;
  }
  {%- if armel_display == 'cormorant' %}
  @font-face { font-family: 'Armel Cormorant'; font-weight: 400; font-display: swap; src: url('{{ 'armel-cormorant-latin-400.woff2' | asset_url }}') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212; }
  @font-face { font-family: 'Armel Cormorant'; font-weight: 400; font-display: swap; src: url('{{ 'armel-cormorant-latin-ext-400.woff2' | asset_url }}') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+20A0-20C0, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Armel Cormorant'; font-weight: 500; font-display: swap; src: url('{{ 'armel-cormorant-latin-500.woff2' | asset_url }}') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212; }
  @font-face { font-family: 'Armel Cormorant'; font-weight: 500; font-display: swap; src: url('{{ 'armel-cormorant-latin-ext-500.woff2' | asset_url }}') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+20A0-20C0, U+2C60-2C7F, U+A720-A7FF; }
  {%- endif %}

  :root {
    --a-script: 'Armel Script', 'Pinyon Script', cursive;
    {%- case armel_display -%}
      {%- when 'cormorant' %}
    --a-display: 'Armel Cormorant', 'Cormorant Garamond', Garamond, serif;
    --a-display-weight: 500;
    --a-display-tracking: 0;
    --a-display-adjust: 0.48;
      {%- else %}
    --a-display: var(--font-body--family), 'Montserrat', sans-serif;
    --a-display-weight: 600;
    --a-display-tracking: -0.015em;
    --a-display-adjust: none;
    {%- endcase %}
    --armel-nav-case: {% if armel_nav_upper %}uppercase{% else %}none{% endif %};
    --armel-nav-tracking: {% if armel_nav_upper %}0.1em{% else %}0{% endif %};
    --armel-nav-size: {% if armel_nav_upper %}12px{% else %}13px{% endif %};
  }

  /* Collection / products page title — handwritten script */
  body.template-collection #MainContent > .shopify-section:first-child h1 {
    margin: 0;
    font-family: var(--a-script);
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.01em;
    line-height: 1.05;
    text-transform: none;
    color: #7d3031;
    -webkit-font-smoothing: antialiased;
  }

  body.template-collection #MainContent > .shopify-section:first-child .text-block.paragraph {
    max-width: 34rem;
    color: #7d3031;
    font-size: 15px;
    line-height: 1.65;
  }

  body.template-collection #MainContent > .shopify-section:first-child .text-block.paragraph p {
    margin: 0;
  }
</style>
