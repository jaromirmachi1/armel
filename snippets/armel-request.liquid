{%- comment -%}
  Reads kategorie and barva from the current URL. Echoes "kategorie|barva".
{%- endcomment -%}
{%- liquid
  assign kat = ''
  assign color = ''
  capture raw_header
    echo content_for_header
  endcapture
  assign page_url = raw_header | split: '"pageurl":"' | last | split: '"' | first
  assign page_url = page_url | replace: '\/', '/' | replace: '\u0026', '&' | replace: '\u003f', '?' | replace: '\u003F', '?' | replace: '&amp;', '&'
  if page_url contains '?'
    assign query = page_url | split: '?' | last
    assign pairs = query | split: '&'
    for pair in pairs
      assign key = pair | split: '=' | first
      assign val = pair | split: '=' | last | split: '#' | first
      if key == 'kategorie'
        assign kat = val
      elsif key == 'barva'
        assign color = val
      endif
    endfor
  endif
  echo kat | append: '|' | append: color
-%}
