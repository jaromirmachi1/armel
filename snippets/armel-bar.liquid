{%- liquid
  assign bar_id = bar_id | default: 'store'
  assign bar_home = is_home | default: false
  assign bar_currency = localization.country.currency.iso_code | default: 'CZK'
  assign bar_lang = localization.language.iso_code | upcase | default: 'CS'
  assign bar_switch = false
  if localization.available_languages.size > 1 or localization.available_countries.size > 1
    assign bar_switch = true
  endif
-%}

<header class="armel-hero__bar" data-armel-bar>
  <div class="armel-hero__start">
    <button
      class="armel-hero__toggle"
      type="button"
      data-armel-toggle
      aria-expanded="false"
      aria-controls="ArmelNav-{{ bar_id }}"
      aria-label="{{ 'accessibility.menu' | t }}"
      data-open-label="{{ 'accessibility.menu' | t }}"
      data-close-label="{{ 'accessibility.close_dialog' | t }}"
    >
      <span class="armel-hero__toggle-bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      </button>

    <nav
      id="ArmelNav-{{ bar_id }}"
      class="armel-hero__nav"
      data-armel-nav
      aria-label="{{ 'accessibility.header_navigation_label' | t }}"
    >
    {%- if links != blank -%}
      {%- for block in links -%}
        {%- liquid
          assign link_url = block.settings.link
          if link_url == blank
            assign link_url = routes.root_url
          endif
          assign link_slash = link_url | append: '/'
          assign link_current = false
          if request.path == link_url or request.path == link_slash
            assign link_current = true
          endif
        -%}
        <a
          href="{{ link_url }}"
          {% if link_current %}
            aria-current="page"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.root_url }}" {% if request.path == routes.root_url %}aria-current="page"{% endif %}>Domů</a>
      <a href="{{ routes.all_products_collection_url }}" {% if request.path == routes.all_products_collection_url %}aria-current="page"{% endif %}>Všechny produkty</a>
      <a href="/collections/kozena-pouzdra" {% if request.path == '/collections/kozena-pouzdra' %}aria-current="page"{% endif %}>Kožená pouzdra</a>
      <a href="/collections/doplnky" {% if request.path == '/collections/doplnky' %}aria-current="page"{% endif %}>Doplňky</a>
      <a href="/collections/zapisniky" {% if request.path == '/collections/zapisniky' %}aria-current="page"{% endif %}>Zápisníky</a>
      <a href="/pages/o-nas" {% if request.path == '/pages/o-nas' %}aria-current="page"{% endif %}>O nás</a>
      <a href="/pages/kontakt" {% if request.path == '/pages/kontakt' %}aria-current="page"{% endif %}>Kontakt</a>
    {%- endif -%}
  </nav>
  </div>

  <div class="armel-hero__mark">
    <a
      href="{{ routes.root_url }}"
      {% if bar_home %}
        aria-current="page"
      {% endif %}
    >
      <img
        class="armel-hero__logo"
        src="{{ 'armel-logo.png' | asset_url }}"
        alt="{{ 'accessibility.home_logo_alt' | t: store_name: shop.name }}"
        width="240"
        height="77"
        decoding="async"
      >
    </a>
  </div>

  <div class="armel-hero__tools">
    {%- if bar_switch -%}
      <details class="armel-hero__switch">
        <summary>
          {%- if localization.country.iso_code == 'CZ' -%}
            <svg class="armel-hero__flag" viewBox="0 0 18 12" aria-hidden="true">
              <rect width="18" height="6" fill="#ffffff"/>
              <rect y="6" width="18" height="6" fill="#d7141a"/>
              <path d="M0 0l8 6-8 6z" fill="#11457e"/>
            </svg>
          {%- endif -%}
          <span>{{ bar_currency }} / {{ bar_lang }}</span>
          <svg class="armel-hero__chevron" viewBox="0 0 10 6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
          </svg>
        </summary>
        {% form 'localization', class: 'armel-hero__switch-panel' %}
          {%- if localization.available_languages.size > 1 -%}
            {%- for language in localization.available_languages -%}
              <button type="submit" name="locale_code" value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}>
                {{ language.endonym_name }}
              </button>
            {%- endfor -%}
          {%- endif -%}
          {%- if localization.available_countries.size > 1 -%}
            {%- for country in localization.available_countries -%}
              <button type="submit" name="country_code" value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}aria-current="true"{% endif %}>
                {{ country.currency.iso_code }} · {{ country.name }}
              </button>
            {%- endfor -%}
          {%- endif -%}
        {% endform %}
      </details>
    {%- else -%}
      <span class="armel-hero__switch armel-hero__switch--static">
        {%- if localization.country.iso_code == 'CZ' or localization.country.iso_code == blank -%}
          <svg class="armel-hero__flag" viewBox="0 0 18 12" aria-hidden="true">
            <rect width="18" height="6" fill="#ffffff"/>
            <rect y="6" width="18" height="6" fill="#d7141a"/>
            <path d="M0 0l8 6-8 6z" fill="#11457e"/>
          </svg>
        {%- endif -%}
        <span>{{ bar_currency }} / {{ bar_lang }}</span>
      </span>
    {%- endif -%}

    <button
      class="armel-hero__icon-btn"
      type="button"
      on:click="#search-modal/showDialog"
      aria-haspopup="dialog"
      aria-label="{{ 'content.search_input_label' | t }}"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
        <circle cx="7.1" cy="7.1" r="4.15" stroke="currentColor" stroke-width="1.15"/>
        <path d="M10.3 10.3L13.2 13.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
      </svg>
    </button>

    <a
      class="armel-hero__icon-btn"
      href="{{ routes.account_url }}"
      aria-label="{{ 'accessibility.account' | t }}"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
        <circle cx="8" cy="5.15" r="2.15" stroke="currentColor" stroke-width="1.15"/>
        <path d="M3.15 13.15c.72-2.25 2.45-3.35 4.85-3.35s4.13 1.1 4.85 3.35" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
      </svg>
    </a>

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      <button
        class="armel-hero__icon-btn"
        type="button"
        on:click="#cart-drawer/toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="cart-drawer"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <path d="M4.15 6.15h7.7v7.15H4.15V6.15Z" stroke="currentColor" stroke-width="1.15"/>
          <path d="M6.15 6.15V4.9a1.85 1.85 0 0 1 3.7 0v1.25" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="armel-hero__count">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="visually-hidden">
          {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
        </span>
      </button>
    {%- else -%}
      <a
        class="armel-hero__icon-btn"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <path d="M4.15 6.15h7.7v7.15H4.15V6.15Z" stroke="currentColor" stroke-width="1.15"/>
          <path d="M6.15 6.15V4.9a1.85 1.85 0 0 1 3.7 0v1.25" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="armel-hero__count">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="visually-hidden">
          {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
        </span>
      </a>
    {%- endif -%}
  </div>
</header>

<script>
  (function () {
    var bar = document.currentScript && document.currentScript.previousElementSibling;
    if (!bar) return;
    var button = bar.querySelector('[data-armel-toggle]');
    var nav = bar.querySelector('[data-armel-nav]');
    if (!button || !nav) return;

    function setOpen(open) {
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) nav.setAttribute('data-open', 'true');
      else nav.removeAttribute('data-open');
      button.setAttribute('aria-label', open ? button.getAttribute('data-close-label') : button.getAttribute('data-open-label'));
    }

    button.addEventListener('click', function () {
      var open = button.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) {
        var details = bar.querySelector('details[open]');
        if (details) details.removeAttribute('open');
        var first = nav.querySelector('a');
        if (first) first.focus();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      var details = bar.querySelector('details[open]');
      if (details) {
        details.removeAttribute('open');
        var summary = details.querySelector('summary');
        if (summary) summary.focus();
        return;
      }
      if (button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    document.addEventListener('click', function (event) {
      var details = bar.querySelector('details[open]');
      if (details && !details.contains(event.target)) details.removeAttribute('open');
    });

    nav.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });
  })();
</script>
