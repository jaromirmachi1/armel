{%- liquid
  assign bar_id = bar_id | default: 'store'
  assign bar_home = is_home | default: false
  assign bar_currency = localization.country.currency.iso_code | default: 'CZK'
  assign bar_lang = localization.language.iso_code | upcase | default: 'CS'
  assign bar_switch = false
  if localization.available_languages.size > 1 or localization.available_countries.size > 1
    assign bar_switch = true
  endif
-%}

{%- capture armel_catalog -%}
      <li><a href="{{ routes.collections_url }}">{{ 'armel.mega.laptop' | t }}</a></li>
      <li><a href="{{ routes.collections_url }}">{{ 'armel.mega.accessories' | t }}</a></li>
      <li><a href="{{ routes.collections_url }}">{{ 'armel.mega.journal' | t }}</a></li>
{%- endcapture -%}
{%- capture armel_mega -%}
  {%- liquid
    assign mega_tags = 'laptop-obaly,obaly-na-balzam,obaly-na-denik' | split: ','
    assign mega_titles = 'Laptop obaly,Doplňky,Leather journal' | split: ','
    assign mega_title_keys = 'mega.laptop,mega.accessories,mega.journal' | split: ','
    assign mega_handles = 'kozena-pouzdra,doplnky,zapisniky' | split: ','
  -%}
  <div class="armel-mega">
    <div class="armel-mega__cats" role="tablist">
      {%- for mega_tag in mega_tags -%}
        {%- assign mega_i = forloop.index0 -%}
        {%- assign mega_col = collections[mega_handles[mega_i]] -%}
        {%- capture mega_title -%}{%- render 'armel-line', key: mega_title_keys[mega_i], text: mega_titles[mega_i] -%}{%- endcapture -%}
        {%- assign mega_title = mega_title | strip -%}
        {%- if mega_col != blank and mega_col.products_count > 0 -%}
          {%- assign mega_title = mega_col.title | escape -%}
        {%- endif -%}
        {%- assign mega_href = routes.all_products_collection_url | append: '?filter.p.tag=' | append: mega_tag -%}
        <a
          href="{{ mega_href }}"
          role="tab"
          data-mega-cat="{{ mega_i }}"
          {% if forloop.first %}aria-selected="true"{% endif %}
        >{{ mega_title }}</a>
      {%- endfor -%}
    </div>
    {%- for mega_tag in mega_tags -%}
      {%- assign mega_i = forloop.index0 -%}
      {%- assign mega_col = collections[mega_handles[mega_i]] -%}
      {%- assign mega_from_collection = false -%}
      {%- if mega_col != blank and mega_col.products_count > 0 -%}
        {%- assign mega_from_collection = true -%}
      {%- endif -%}
      {%- assign mega_href = routes.all_products_collection_url | append: '?filter.p.tag=' | append: mega_tag -%}
      <div class="armel-mega__pane" role="tabpanel" data-mega-grid="{{ mega_i }}" {% unless forloop.first %}hidden{% endunless %}>
        <div class="armel-mega__grid">
          {%- assign mega_shown = 0 -%}
          {%- if mega_from_collection -%}
            {%- for product in mega_col.products limit: 4 -%}
              <a class="armel-mega__card" href="{{ product.url }}">
                <span class="armel-mega__media">
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 640
                      | image_tag:
                        widths: '240, 360, 480, 640',
                        sizes: '22vw',
                        loading: 'lazy',
                        alt: product.featured_image.alt
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
                <span class="armel-mega__meta">
                  <span class="armel-mega__name">{{ product.title | escape }}</span>
                  <span class="armel-mega__price">{{ product.price | money }}</span>
                </span>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for product in collections.all.products -%}
              {%- if mega_shown < 4 and product.tags contains mega_tag -%}
                {%- assign mega_shown = mega_shown | plus: 1 -%}
                <a class="armel-mega__card" href="{{ product.url }}">
                  <span class="armel-mega__media">
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 640
                        | image_tag:
                          widths: '240, 360, 480, 640',
                          sizes: '22vw',
                          loading: 'lazy',
                          alt: product.featured_image.alt
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </span>
                  <span class="armel-mega__meta">
                    <span class="armel-mega__name">{{ product.title | escape }}</span>
                    <span class="armel-mega__price">{{ product.price | money }}</span>
                  </span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <a class="armel-mega__more" href="{{ mega_href }}">{{ 'armel.show_collection' | t }}</a>
      </div>
    {%- endfor -%}
  </div>
{%- endcapture -%}
{%- capture armel_switch -%}
    {%- liquid
      assign czk_code = ''
      assign eur_code = ''
      assign eur_prefer = 'DE,AT,SK,FR,NL,IE,IT,ES,BE,PT,FI' | split: ','
      for country in localization.available_countries
        if country.currency.iso_code == 'CZK' and czk_code == blank
          assign czk_code = country.iso_code
        endif
      endfor
      for code in eur_prefer
        if eur_code != blank
          break
        endif
        for country in localization.available_countries
          if country.currency.iso_code == 'EUR' and country.iso_code == code
            assign eur_code = country.iso_code
            break
          endif
        endfor
      endfor
      if eur_code == blank
        for country in localization.available_countries
          if country.currency.iso_code == 'EUR'
            assign eur_code = country.iso_code
            break
          endif
        endfor
      endif
      if czk_code == blank
        assign czk_code = 'CZ'
      endif
    -%}
    <details class="armel-hero__switch">
      <summary>
        {%- if bar_currency == 'CZK' -%}
          <svg class="armel-hero__flag" viewBox="0 0 18 12" aria-hidden="true">
            <rect width="18" height="6" fill="#ffffff"/>
            <rect y="6" width="18" height="6" fill="#d7141a"/>
            <path d="M0 0l8 6-8 6z" fill="#11457e"/>
          </svg>
        {%- elsif bar_currency == 'EUR' -%}
          <svg class="armel-hero__flag" viewBox="0 0 18 12" aria-hidden="true">
            <rect width="18" height="12" fill="#003399"/>
            <circle cx="9" cy="6" r="2.1" fill="none" stroke="#fc0" stroke-width="0.7"/>
          </svg>
        {%- endif -%}
        <span>{{ bar_currency }} / {{ bar_lang }}</span>
        <svg class="armel-hero__chevron" viewBox="0 0 10 6" aria-hidden="true">
          <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
        </svg>
      </summary>
      <div class="armel-hero__switch-panel">
        {% form 'localization' %}
          <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
          <p class="armel-hero__switch-label">{{ 'armel.language' | t }}</p>
          <button type="submit" name="language_code" value="cs" {% if localization.language.iso_code == 'cs' %}aria-current="true"{% endif %}>CS</button>
          <button type="submit" name="language_code" value="en" {% if localization.language.iso_code == 'en' %}aria-current="true"{% endif %}>EN</button>
        {% endform %}
        {% form 'localization' %}
          <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">
          <p class="armel-hero__switch-label">{{ 'armel.currency' | t }}</p>
          <button type="submit" name="country_code" value="{{ czk_code }}" {% if bar_currency == 'CZK' %}aria-current="true"{% endif %}>CZK</button>
          {%- if eur_code != blank -%}
            <button type="submit" name="country_code" value="{{ eur_code }}" {% if bar_currency == 'EUR' %}aria-current="true"{% endif %}>EUR</button>
          {%- endif -%}
        {% endform %}
      </div>
    </details>
{%- endcapture -%}

<header class="armel-hero__bar" data-armel-bar>
  <div class="armel-hero__start">
    <button
      class="armel-hero__toggle"
      type="button"
      data-armel-toggle
      aria-expanded="false"
      aria-controls="ArmelDrawer-{{ bar_id }}"
      aria-label="{{ 'accessibility.menu' | t }}"
      data-open-label="{{ 'accessibility.menu' | t }}"
      data-close-label="{{ 'accessibility.close_dialog' | t }}"
    >
      <span class="armel-hero__toggle-bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      </button>

    <nav
      id="ArmelNav-{{ bar_id }}"
      class="armel-hero__nav"
      data-armel-nav
      aria-label="{{ 'accessibility.header_navigation_label' | t }}"
    >
    {%- if links != blank -%}
      {%- for block in links -%}
        {%- liquid
          assign link_url = block.settings.link
          if link_url == blank
            assign link_url = routes.root_url
          endif
        -%}
        {%- capture link_url -%}{%- render 'armel-href', path: link_url -%}{%- endcapture -%}
        {%- liquid
          assign link_url = link_url | strip
          assign link_slash = link_url | append: '/'
          assign link_current = false
          if request.path == link_url or request.path == link_slash
            assign link_current = true
          endif
          assign link_label_down = block.settings.label | downcase
          assign is_products = false
          if link_url == routes.all_products_collection_url or link_url contains '/collections/all' or link_label_down == 'produkty'
            assign is_products = true
          endif
        -%}
        <a
          href="{{ link_url }}"
          {% if link_current %}
            aria-current="page"
          {% endif %}
          {% if is_products %}
            data-armel-collections
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="ArmelCollections-{{ bar_id }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- liquid
            assign shown_label = block.settings.label
            if shown_label == 'Produkty'
              assign shown_label = 'armel.products' | t
            elsif shown_label == 'Galerie'
              assign shown_label = 'armel.gallery' | t
            endif
          -%}
          {{ shown_label | escape }}
        </a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}" {% if request.path == routes.all_products_collection_url %}aria-current="page"{% endif %} data-armel-collections aria-haspopup="dialog" aria-expanded="false" aria-controls="ArmelCollections-{{ bar_id }}">{{ 'armel.products' | t }}</a>
      {%- capture dna_href -%}{%- render 'armel-href', path: '/pages/dna' -%}{%- endcapture -%}
      {%- capture galerie_href -%}{%- render 'armel-href', path: '/pages/galerie' -%}{%- endcapture -%}
      {%- assign dna_href = dna_href | strip -%}
      {%- assign galerie_href = galerie_href | strip -%}
      <a href="{{ dna_href }}" {% if request.path == dna_href %}aria-current="page"{% endif %}>DNA</a>
      <a href="{{ galerie_href }}" {% if request.path == galerie_href %}aria-current="page"{% endif %}>{{ 'armel.gallery' | t }}</a>
    {%- endif -%}
  </nav>
  </div>

  <div class="armel-hero__mark">
    <a
      href="{{ routes.root_url }}"
      {% if bar_home %}
        aria-current="page"
      {% endif %}
    >
      <img
        class="armel-hero__logo"
        src="{{ 'armel-logo.png' | asset_url }}"
        alt="{{ 'accessibility.home_logo_alt' | t: store_name: shop.name }}"
        width="240"
        height="77"
        decoding="async"
      >
      <img
        class="armel-hero__logo armel-hero__logo--silver"
        src="{{ 'armel-logo-silver.png' | asset_url }}"
        alt=""
        aria-hidden="true"
        width="1080"
        height="312"
        loading="lazy"
        decoding="async"
      >
    </a>
  </div>

  <div class="armel-hero__tools">
    {{ armel_switch }}

    <button
      class="armel-hero__icon-btn"
      type="button"
      on:click="#search-modal/showDialog"
      aria-haspopup="dialog"
      aria-label="{{ 'content.search_input_label' | t }}"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
        <circle cx="7.1" cy="7.1" r="4.15" stroke="currentColor" stroke-width="1.15"/>
        <path d="M10.3 10.3L13.2 13.2" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
      </svg>
    </button>

    <a
      class="armel-hero__icon-btn"
      href="{{ routes.account_url }}"
      aria-label="{{ 'accessibility.account' | t }}"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
        <circle cx="8" cy="5.15" r="2.15" stroke="currentColor" stroke-width="1.15"/>
        <path d="M3.15 13.15c.72-2.25 2.45-3.35 4.85-3.35s4.13 1.1 4.85 3.35" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
      </svg>
    </a>

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      <button
        class="armel-hero__icon-btn"
        type="button"
        on:click="#cart-drawer/toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="cart-drawer"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <path d="M4.15 6.15h7.7v7.15H4.15V6.15Z" stroke="currentColor" stroke-width="1.15"/>
          <path d="M6.15 6.15V4.9a1.85 1.85 0 0 1 3.7 0v1.25" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="armel-hero__count">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="visually-hidden">
          {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
        </span>
      </button>
    {%- else -%}
      <a
        class="armel-hero__icon-btn"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <path d="M4.15 6.15h7.7v7.15H4.15V6.15Z" stroke="currentColor" stroke-width="1.15"/>
          <path d="M6.15 6.15V4.9a1.85 1.85 0 0 1 3.7 0v1.25" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="armel-hero__count">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="visually-hidden">
          {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
        </span>
      </a>
    {%- endif -%}
  </div>

  <div
    class="armel-hero__panel"
    id="ArmelCollections-{{ bar_id }}"
    data-armel-panel
    role="dialog"
    aria-label="{{ 'armel.collections' | t }}"
    aria-hidden="true"
  >
    {{ armel_mega }}
  </div>

  <div class="armel-drawer" id="ArmelDrawer-{{ bar_id }}" data-armel-drawer aria-hidden="true">
    <div class="armel-drawer__inner" data-lenis-prevent>
      <nav class="armel-drawer__nav" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
        <ul class="armel-drawer__links" role="list">
          {%- if links != blank -%}
            {%- for block in links -%}
              {%- liquid
                assign d_path = block.settings.link
                if d_path == blank
                  assign d_path = routes.root_url
                endif
              -%}
              {%- capture d_url -%}{%- render 'armel-href', path: d_path -%}{%- endcapture -%}
              {%- liquid
                assign d_url = d_url | strip
                assign d_label_down = block.settings.label | downcase
                assign d_products = false
                if d_url == routes.all_products_collection_url or d_url contains '/collections/all' or d_label_down == 'produkty'
                  assign d_products = true
                endif
              -%}
              <li style="--i: {{ forloop.index0 }};">
                {%- liquid
                  assign shown_label = block.settings.label
                  if shown_label == 'Produkty'
                    assign shown_label = 'armel.products' | t
                  elsif shown_label == 'Galerie'
                    assign shown_label = 'armel.gallery' | t
                  endif
                -%}
                <a class="armel-drawer__link" href="{{ d_url }}" {% if request.path == d_url %}aria-current="page"{% endif %}>{{ shown_label | escape }}</a>
                {%- if d_products -%}
                  <ul class="armel-drawer__sub" role="list">{{ armel_catalog }}</ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li style="--i: 0;">
              <a class="armel-drawer__link" href="{{ routes.all_products_collection_url }}">{{ 'armel.products' | t }}</a>
              <ul class="armel-drawer__sub" role="list">{{ armel_catalog }}</ul>
            </li>
            <li style="--i: 1;"><a class="armel-drawer__link" href="{{ dna_href | strip }}">DNA</a></li>
            <li style="--i: 2;"><a class="armel-drawer__link" href="{{ galerie_href | strip }}">{{ 'armel.gallery' | t }}</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <a class="armel-drawer__feature" href="{{ routes.all_products_collection_url }}">
        <img src="{{ 'armel-clutch-closed.jpg' | asset_url }}" alt="" width="1500" height="1017" loading="lazy" decoding="async">
        <span class="armel-drawer__feature-text">
          <span class="armel-drawer__feature-title">{{ 'armel.handmade' | t }}</span>
          <span class="armel-drawer__feature-cta">{{ 'armel.view_collection' | t }}</span>
        </span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <div class="armel-drawer__foot">
        <div class="armel-drawer__switch">{{ armel_switch }}</div>
        <a class="armel-drawer__mail" href="mailto:info@armelhouse.com">info@armelhouse.com</a>
        <a class="armel-drawer__account" href="{{ routes.account_url }}">{{ 'armel.account' | t }}</a>
        {%- capture returns_href -%}{%- render 'armel-href', path: '/pages/vraceni' -%}{%- endcapture -%}
        <a class="armel-drawer__account armel-drawer__account--end" href="{{ returns_href | strip }}">{% if localization.language.iso_code == 'en' %}Returns{% else %}Vrácení{% endif %}</a>
        <span
          class="armel-drawer__sig"
          role="img"
          aria-label="by Aneta &amp; Marína"
          style="-webkit-mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}'); mask-image: url('{{ 'by-aneta-marina-black.png' | asset_url }}');"
        ></span>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    var bar = document.currentScript && document.currentScript.previousElementSibling;
    if (!bar) return;
    /* Transparent at the top of the page, white once the visitor scrolls a little. */
    /* Horizon scrolls .page-wrapper (not the window) from 990px up, so listen to whichever scrolls. */
    var wrapper = bar.closest('.page-wrapper') || document.querySelector('.page-wrapper');
    var ticking = false;
    function scrollTop() {
      var w = wrapper ? wrapper.scrollTop : 0;
      return Math.max(w, window.scrollY || document.documentElement.scrollTop || 0);
    }
    function syncScrolled() {
      ticking = false;
      if (scrollTop() > 24) bar.setAttribute('data-scrolled', '');
      else bar.removeAttribute('data-scrolled');
    }
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(syncScrolled);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    if (wrapper) wrapper.addEventListener('scroll', onScroll, { passive: true });
    var barWidth = window.innerWidth;
    window.addEventListener('resize', function () {
      if (window.innerWidth === barWidth) return;
      barWidth = window.innerWidth;
      onScroll();
    });
    syncScrolled();
    /* switch transitions on only after the first paint, so a reload mid-page doesn't animate */
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { bar.setAttribute('data-bar-ready', ''); });
    });

    var button = bar.querySelector('[data-armel-toggle]');
    var nav = bar.querySelector('[data-armel-nav]');
    if (!button || !nav) return;

    var drawer = bar.querySelector('[data-armel-drawer]');
    function setOpen(open) {
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) nav.setAttribute('data-open', 'true');
      else nav.removeAttribute('data-open');
      if (drawer) {
        drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (open) drawer.setAttribute('data-open', 'true');
        else drawer.removeAttribute('data-open');
      }
      if (open) bar.setAttribute('data-menu-open', '');
      else bar.removeAttribute('data-menu-open');
      /* Horizon's own scroll lock (also pauses smooth scroll) */
      if (open) document.documentElement.setAttribute('scroll-lock', '');
      else document.documentElement.removeAttribute('scroll-lock');
      button.setAttribute('aria-label', open ? button.getAttribute('data-close-label') : button.getAttribute('data-open-label'));
    }

    button.addEventListener('click', function () {
      var open = button.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) {
        var details = bar.querySelector('details[open]');
        if (details) details.removeAttribute('open');
        var first = (drawer && getComputedStyle(drawer).display !== 'none' ? drawer : nav).querySelector('a');
        if (first) setTimeout(function () { first.focus({ preventScroll: true }); }, 320);
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      var details = bar.querySelector('details[open]');
      if (details) {
        details.removeAttribute('open');
        var summary = details.querySelector('summary');
        if (summary) summary.focus();
        return;
      }
      if (button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    document.addEventListener('click', function (event) {
      var details = bar.querySelector('details[open]');
      if (details && !details.contains(event.target)) details.removeAttribute('open');
    });

    nav.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });
    if (drawer) {
      drawer.addEventListener('click', function (event) {
        if (event.target.closest('a')) setOpen(false);
      });
      window.addEventListener('resize', function () {
        if (button.getAttribute('aria-expanded') === 'true' && getComputedStyle(button).display === 'none') setOpen(false);
      });
    }

    var catalog = bar.querySelector('[data-armel-collections]');
    var panel = bar.querySelector('[data-armel-panel]');
    var catalogTimer;
    var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches && window.matchMedia('(min-width: 1361px)').matches;

    function setCatalog(open) {
      if (!catalog || !panel) return;
      catalog.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open) bar.setAttribute('data-collections-open', 'true');
      else bar.removeAttribute('data-collections-open');
    }

    function queueCatalogClose() {
      clearTimeout(catalogTimer);
      catalogTimer = setTimeout(function () { setCatalog(false); }, 140);
    }

    function showMega(index) {
      if (!panel) return;
      panel.querySelectorAll('[data-mega-cat]').forEach(function (tab) {
        var on = tab.getAttribute('data-mega-cat') === String(index);
        if (on) tab.setAttribute('aria-selected', 'true');
        else tab.removeAttribute('aria-selected');
      });
      panel.querySelectorAll('[data-mega-grid]').forEach(function (grid) {
        if (grid.getAttribute('data-mega-grid') === String(index)) grid.removeAttribute('hidden');
        else grid.setAttribute('hidden', '');
      });
    }

    if (catalog && panel && canHover) {
      catalog.addEventListener('pointerenter', function () {
        clearTimeout(catalogTimer);
        setCatalog(true);
      });
      catalog.addEventListener('pointerleave', queueCatalogClose);
      panel.addEventListener('pointerenter', function () { clearTimeout(catalogTimer); });
      panel.addEventListener('pointerleave', queueCatalogClose);
      panel.querySelectorAll('[data-mega-cat]').forEach(function (tab) {
        tab.addEventListener('pointerenter', function () {
          showMega(tab.getAttribute('data-mega-cat'));
        });
        tab.addEventListener('focus', function () {
          showMega(tab.getAttribute('data-mega-cat'));
        });
      });
      catalog.addEventListener('focus', function () { setCatalog(true); });
      panel.addEventListener('focusout', function (event) {
        if (!panel.contains(event.relatedTarget) && event.relatedTarget !== catalog) setCatalog(false);
      });
      catalog.addEventListener('blur', function (event) {
        if (!panel.contains(event.relatedTarget)) queueCatalogClose();
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && bar.hasAttribute('data-collections-open')) {
        setCatalog(false);
        if (catalog) catalog.focus();
      }
    });
  })();
</script>
