{%- comment -%}
  Collection URL with the category and color filters.
  {% render 'armel-cat-href', kat: 'doplnky', color: 'cerna' %}
{%- endcomment -%}
{%- liquid
  assign href_path = '/collections/all'
  if kat != blank
    assign href_path = href_path | append: '?kategorie=' | append: kat
  endif
  if color != blank
    if href_path contains '?'
      assign href_path = href_path | append: '&barva=' | append: color
    else
      assign href_path = href_path | append: '?barva=' | append: color
    endif
  endif
-%}
{%- capture armel_cat_href -%}{%- render 'armel-href', path: href_path -%}{%- endcapture -%}
{{- armel_cat_href | strip -}}
