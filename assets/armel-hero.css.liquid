.armel-hero-section {
  display: flex;
  flex-direction: column;
  min-height: 100dvh;
  background: #e4e2df;
}

.armel-hero {
  --armel-ink: #7a5252;
  --armel-wall: #e4e2df;
  --armel-ease: cubic-bezier(0.23, 1, 0.32, 1);
  position: relative;
  flex: 1 1 auto;
  min-height: 100dvh;
  overflow: hidden;
  color: var(--armel-ink);
  background: var(--armel-wall);
  isolation: isolate;
}

.armel-hero__photo {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: center top;
}

.armel-hero__bar {
  position: absolute;
  z-index: 2;
  inset-inline: 0;
  top: 0;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
  padding: max(22px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) 0
    max(20px, env(safe-area-inset-left));
  font-family: var(--font-body--family), "Montserrat", "Avenir Next", "Segoe UI", sans-serif;
  font-weight: 400;
  font-size: 11px;
  line-height: 1;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.armel-hero__start {
  display: flex;
  align-items: center;
  min-width: 0;
}

.armel-hero__mark {
  margin: 0;
  line-height: 0;
  text-align: center;
}

.armel-hero__mark a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.armel-hero__logo {
  display: block;
  width: clamp(7.5rem, 11vw, 9.5rem);
  height: auto;
  max-width: 100%;
}

.armel-hero__nav {
  display: flex;
  align-items: center;
  gap: 0.95rem;
}

.armel-hero__nav a {
  display: inline-flex;
  align-items: center;
  min-height: 40px;
}

.armel-hero__nav a,
.armel-hero__locale,
.armel-hero__locale-select {
  color: inherit;
  text-decoration: none;
  letter-spacing: 0.18em;
}

.armel-hero__tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0;
}

.armel-hero__locale {
  margin-inline-end: 8px;
  padding: 12px 4px;
}

.armel-hero__locale-form {
  margin-inline-end: 8px;
}

.armel-hero__locale-select {
  appearance: none;
  margin: 0;
  padding: 12px 2px;
  border: 0;
  background: transparent;
  font: inherit;
  text-transform: uppercase;
  cursor: pointer;
}

.armel-hero__icon-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  text-decoration: none;
  cursor: pointer;
}

.armel-hero__icon-btn svg {
  width: 15px;
  height: 15px;
  display: block;
}

.armel-hero__count {
  position: absolute;
  top: 6px;
  inset-inline-end: 4px;
  font-family: var(--font-body--family), "Montserrat", sans-serif;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.armel-hero__toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  margin-inline-start: -10px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.armel-hero__toggle-bars {
  position: relative;
  display: block;
  width: 16px;
  height: 9px;
}

.armel-hero__toggle-bars span {
  position: absolute;
  inset-inline: 0;
  height: 1px;
  background: currentColor;
  transform-origin: center;
  transition: transform 180ms var(--armel-ease);
}

.armel-hero__toggle-bars span:first-child {
  top: 0;
}

.armel-hero__toggle-bars span:last-child {
  bottom: 0;
}

.armel-hero__toggle[aria-expanded="true"] .armel-hero__toggle-bars span:first-child {
  transform: translateY(4px) rotate(45deg);
}

.armel-hero__toggle[aria-expanded="true"] .armel-hero__toggle-bars span:last-child {
  transform: translateY(-4px) rotate(-45deg);
}

.armel-hero__bar a,
.armel-hero__toggle,
.armel-hero__locale-select,
.armel-hero__icon-btn {
  transition: opacity 160ms var(--armel-ease), transform 160ms var(--armel-ease);
}

.armel-hero__bar a:active,
.armel-hero__toggle:active,
.armel-hero__icon-btn:active {
  transform: scale(0.97);
}

.armel-hero__line {
  position: absolute;
  z-index: 2;
  inset-inline: 0;
  bottom: 0;
  height: 1px;
  background: var(--armel-ink);
  pointer-events: none;
}

@media (hover: hover) and (pointer: fine) {
  .armel-hero__nav a:hover,
  .armel-hero__mark a:hover,
  .armel-hero__icon-btn:hover,
  .armel-hero__toggle:hover,
  .armel-hero__locale-select:hover {
    opacity: 0.62;
  }
}

@media screen and (min-width: 750px) {
  .armel-hero__bar {
    padding-top: max(28px, env(safe-area-inset-top));
    padding-inline: max(40px, env(safe-area-inset-left)) max(40px, env(safe-area-inset-right));
    font-size: 11px;
  }
}

@media screen and (max-width: 749px) {
  .armel-hero__toggle {
    display: inline-flex;
  }

  .armel-hero__nav {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: 2px 20px 14px;
    background: var(--armel-wall);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 180ms var(--armel-ease), transform 180ms var(--armel-ease);
  }

  .armel-hero__nav[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .armel-hero__nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 4px;
    font-size: 12px;
    letter-spacing: 0.16em;
  }
}

@media (prefers-reduced-motion: reduce) {
  .armel-hero__nav,
  .armel-hero__toggle-bars span,
  .armel-hero__bar a,
  .armel-hero__toggle,
  .armel-hero__icon-btn,
  .armel-hero__locale-select {
    transition: none;
  }

  .armel-hero__nav {
    transform: none;
  }
}

body.template-index {
  background: #e4e2df;
}

body.template-index,
body.template-index .page-wrapper {
  scrollbar-color: rgb(122 82 82 / 0.45) #e4e2df;
}

body.template-index ::selection {
  background: #7a5252;
  color: #f4f1ee;
}
