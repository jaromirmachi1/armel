/* Armel hero: the pieces themselves, large, on their own wall. */

.armel-hero-section {
  background: #e4e2df;
}

.armel-hero,
.armel-hero *,
.armel-hero *::before,
.armel-hero *::after {
  box-sizing: border-box;
}

.armel-hero {
  --armel-ink: #7d3031;
  --armel-wall: #e4e2df;
  --armel-ease: cubic-bezier(0.16, 1, 0.3, 1);
  --armel-m: clamp(20px, 3.2vw, 48px);
  position: relative;
  display: grid;
  min-height: 100svh;
  overflow: hidden;
  color: var(--armel-ink);
  background: var(--armel-wall);
  isolation: isolate;
  font-family: var(--font-body--family), 'Montserrat', 'Avenir Next', 'Segoe UI', sans-serif;
}

/* ---------- photograph ---------- */
.armel-hero__photo {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: 50% 0%;
  /* the pieces, bigger than seems reasonable: scaled from the top-left so they move right
     and run off the bottom edge, leaving the wall on the left for the words */
  transform-origin: 0 8%;
  animation: armel-hero-drift 26s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
}

@keyframes armel-hero-drift {
  from { transform: scale(1.24); }
  to { transform: scale(1.3); }
}

/* first paint: bar settles in once (page visits are rare enough for this) */
@keyframes armel-hero-bar-in {
  from {
    opacity: 0;
    transform: translate3d(0, -14px, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes armel-hero-copy-in {
  from {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

html.a-js .armel-hero__bar {
  animation: armel-hero-bar-in 780ms var(--armel-ease) both;
}

html.a-js .armel-hero__sig {
  animation: armel-hero-copy-in 980ms var(--armel-ease) 280ms both;
}

/* ---------- bar ---------- */
.armel-hero__bar {
  position: absolute;
  z-index: 3;
  inset-inline: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 72px;
  padding: max(10px, env(safe-area-inset-top)) var(--armel-m) 10px;
  background: transparent;
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
}

.armel-hero__start {
  display: flex;
  align-items: center;
  min-width: 0;
}

.armel-hero__mark {
  margin: 0;
  line-height: 0;
}

.armel-hero__logo {
  display: block;
  width: clamp(92px, 8vw, 128px);
  height: auto;
}

.armel-hero__nav {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  gap: clamp(14px, 1.5vw, 26px);
  transform: translate(-50%, -50%);
}

.armel-hero__nav a {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  white-space: nowrap;
}

.armel-hero__nav a::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10px;
  height: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 420ms var(--armel-ease);
}

.armel-hero__nav a,
.armel-hero__locale,
.armel-hero__locale-select {
  color: inherit;
  text-decoration: none;
}

.armel-hero__mark a {
  display: inline-flex;
  text-decoration: none;
}

.armel-hero__tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.armel-hero__locale,
.armel-hero__locale-select {
  margin-inline-end: 6px;
  padding: 12px 4px;
  border: 0;
  background: transparent;
  font: inherit;
  appearance: none;
  cursor: pointer;
}

.armel-hero__locale-form {
  margin: 0;
}

.armel-hero__switch {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-inline-end: 2px;
  font-size: 13px;
  letter-spacing: 0.06em;
}

.armel-hero__switch--static {
  min-height: 44px;
  padding-inline: 4px;
}

.armel-hero__switch summary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 4px;
  list-style: none;
  cursor: pointer;
}

.armel-hero__switch summary::-webkit-details-marker {
  display: none;
}

.armel-hero__flag {
  display: block;
  width: 18px;
  height: 12px;
  box-shadow: 0 0 0 1px rgba(42, 18, 19, 0.16);
}

.armel-hero__chevron {
  width: 10px;
  height: 6px;
  transition: transform 200ms var(--armel-ease);
}

.armel-hero__switch[open] .armel-hero__chevron {
  transform: rotate(180deg);
}

.armel-hero__switch-panel {
  position: absolute;
  top: calc(100% - 6px);
  right: 0;
  z-index: 4;
  display: grid;
  min-width: 11rem;
  margin: 0;
  padding: 6px;
  background: #f6f1e8;
  box-shadow: 0 16px 40px rgba(42, 18, 19, 0.12);
}

.armel-hero__switch-panel button {
  min-height: 40px;
  padding: 0 10px;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  letter-spacing: 0;
  text-align: left;
  cursor: pointer;
}

.armel-hero__switch-panel button[aria-current='true'] {
  font-weight: 600;
}

.armel-hero__icon-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  transition: transform 200ms var(--armel-ease), opacity 200ms ease;
}

.armel-hero__icon-btn svg {
  width: 20px;
  height: 20px;
}

.armel-hero__count {
  position: absolute;
  top: 6px;
  right: 2px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 8px;
  background: var(--armel-ink);
  color: #f6f1ec;
  font-size: 13px;
  font-weight: 600;
  line-height: 16px;
  font-variant-numeric: tabular-nums;
}

.armel-hero__toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-inline-start: -12px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.armel-hero__toggle-bars {
  position: relative;
  display: block;
  width: 20px;
  height: 10px;
}

.armel-hero__toggle-bars span {
  position: absolute;
  inset-inline: 0;
  height: 2px;
  background: currentColor;
  transition: transform 260ms var(--armel-ease);
}

.armel-hero__toggle-bars span:first-child { top: 0; }
.armel-hero__toggle-bars span:last-child { bottom: 0; }

.armel-hero__toggle[aria-expanded='true'] .armel-hero__toggle-bars span:first-child {
  transform: translateY(4px) rotate(45deg);
}

.armel-hero__toggle[aria-expanded='true'] .armel-hero__toggle-bars span:last-child {
  transform: translateY(-4px) rotate(-45deg);
}

.armel-hero__icon-btn:active,
.armel-hero__toggle:active,
.armel-hero__switch summary:active {
  transform: scale(0.97);
}

.armel-hero__bar :focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

/* ---------- intro ---------- */
.armel-hero__intro {
  position: relative;
  z-index: 2;
  align-self: end;
  justify-self: start;
  display: grid;
  justify-items: start;
  gap: 20px;
  width: min(42rem, 48vw);
  padding: 0 var(--armel-m) clamp(32px, 6svh, 64px);
}

.armel-hero__title {
  margin: 0;
  max-width: 13em;
  font-size: clamp(40px, 3.4vw, 56px);
  font-weight: 600;
  line-height: 1.04;
  letter-spacing: -0.025em;
  text-wrap: balance;
}

.armel-hero__text {
  margin: 0;
  max-width: 30em;
  font-size: 17px;
  line-height: 1.5;
  color: #3d1a1b;
}

.armel-hero__intro .a-btn {
  margin-top: 8px;
}

.armel-hero__sig {
  position: absolute;
  z-index: 2;
  top: clamp(96px, 16svh, 160px);
  left: var(--armel-m);
  width: clamp(180px, 18vw, 280px);
  color: var(--armel-ink);
}

@media (hover: hover) and (pointer: fine) {
  .armel-hero__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .armel-hero__icon-btn:hover,
  .armel-hero__mark a:hover,
  .armel-hero__locale-select:hover,
  .armel-hero__switch summary:hover {
    opacity: 0.6;
  }
  .armel-hero__switch-panel button:hover {
    background: rgba(125, 48, 49, 0.08);
    opacity: 1;
  }
}

/* ---------- phone ---------- */
@media screen and (max-width: 989px) {
  .armel-hero {
    min-height: 0;
    grid-template-rows: 56svh auto;
  }

  .armel-hero__photo {
    position: relative;
    grid-row: 1;
    grid-column: 1;
    height: 56svh;
    object-position: 50% 0%;
    transform-origin: 50% 0;
    animation-name: armel-hero-drift-sm;
  }

  @keyframes armel-hero-drift-sm {
    from { transform: scale(1.04); }
    to { transform: scale(1.1); }
  }

  .armel-hero__intro {
    grid-row: 2;
    grid-column: 1;
    justify-self: stretch;
    width: 100%;
    max-width: 40rem;
    gap: 16px;
    padding: 28px var(--armel-m) 40px;
  }

  .armel-hero__title {
    font-size: clamp(30px, 8vw, 40px);
  }

  .armel-hero__intro .a-btn {
    width: 100%;
  }

  .armel-hero__sig {
    top: calc(56svh - 52px);
    bottom: auto;
    left: auto;
    right: var(--armel-m);
    width: 150px;
  }
}

@media screen and (max-width: 1240px) {
  .armel-hero__toggle {
    display: inline-flex;
  }

  .armel-hero__nav {
    top: 100%;
    left: 0;
    right: 0;
    z-index: 2;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    padding: 8px var(--armel-m) 20px;
    background: #f6f1e8;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 240ms var(--armel-ease), transform 240ms var(--armel-ease), visibility 0s 240ms;
  }

  .armel-hero__nav[data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition: opacity 240ms var(--armel-ease), transform 240ms var(--armel-ease);
  }

  .armel-hero__nav a {
    min-height: 48px;
    font-size: 20px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .armel-hero__photo,
  html.a-js .armel-hero__sig {
    animation: none;
    transform: none;
    opacity: 1;
  }
  html.a-js .armel-hero__bar {
    animation: none;
    opacity: 1;
  }
  .armel-hero__nav,
  .armel-hero__nav a::after,
  .armel-hero__toggle-bars span,
  .armel-hero__chevron {
    transition: none;
  }
}
