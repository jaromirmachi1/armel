/* Armel hero: the pieces themselves, large, on their own wall. */

.armel-hero-section {
  background: #e4e2df;
}

.armel-hero,
.armel-hero *,
.armel-hero *::before,
.armel-hero *::after {
  box-sizing: border-box;
}

.armel-hero {
  --armel-ink: #7d3031;
  --armel-wall: #e4e2df;
  --armel-ease: cubic-bezier(0.16, 1, 0.3, 1);
  --armel-m: clamp(20px, 3.2vw, 48px);
  position: relative;
  display: grid;
  min-height: 100svh;
  overflow: hidden;
  color: var(--armel-ink);
  background: var(--armel-wall);
  isolation: isolate;
  font-family: var(--font-body--family), 'Montserrat', 'Avenir Next', 'Segoe UI', sans-serif;
}

/* ---------- photograph / video ---------- */
.armel-hero__photo {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: 50% 0%;
  /* the pieces, bigger than seems reasonable: scaled from the top-left so they move right
     and run off the bottom edge, leaving the wall on the left for the words */
  transform-origin: 0 8%;
  animation: armel-hero-drift 26s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
}

.armel-hero__video {
  z-index: 1;
  animation: none;
  transform: none;
  background: #e4e2df;
}

.armel-hero__photo--fallback {
  z-index: 0;
}

.armel-hero[data-armel-hero-video] .armel-hero__photo:not(.armel-hero__video) {
  animation: none;
  transform: none;
}

@keyframes armel-hero-drift {
  from { transform: scale(1.24); }
  to { transform: scale(1.3); }
}

/* first paint: bar settles in once (page visits are rare enough for this) */
@keyframes armel-hero-bar-in {
  from {
    opacity: 0;
    transform: translate3d(0, -14px, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes armel-hero-copy-in {
  from {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

html.a-js .armel-hero__bar {
  animation: armel-hero-bar-in 780ms var(--armel-ease) both;
}

html.a-js .armel-hero__sig {
  animation: armel-hero-copy-in 980ms var(--armel-ease) 280ms both;
}

/* ---------- bar ---------- */
.armel-hero__bar {
  position: absolute;
  z-index: 3;
  inset-inline: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 72px;
  padding: max(10px, env(safe-area-inset-top)) var(--armel-m) 10px;
  background: transparent;
  /* Serapian-style hairline: inset shadow, not a blurred wash */
  box-shadow: inset 0 -1px rgb(125 48 49 / 0.22);
  font-size: 13px;
  font-weight: 500;
  line-height: 1;
}

.armel-hero__start {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: calc(50% - 84px);
}

.armel-hero__mark {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 50%;
  margin: 0;
  line-height: 0;
  transform: translate(-50%, -50%);
}

.armel-hero__logo {
  display: block;
  width: clamp(92px, 8vw, 128px);
  height: auto;
}

.armel-hero__nav {
  display: flex;
  align-items: center;
  gap: 14px;
}

.armel-hero__nav a,
.armel-hero__panel a {
  font-size: var(--armel-nav-size, 13px);
  letter-spacing: var(--armel-nav-tracking, 0);
  text-transform: var(--armel-nav-case, none);
}

.armel-hero__nav a {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  white-space: nowrap;
}

.armel-hero__nav a::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10px;
  height: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 420ms var(--armel-ease);
}

.armel-hero__panel {
  position: absolute;
  z-index: 4;
  top: 100%;
  left: 0;
  right: 0;
  padding: 6px var(--armel-m) 22px;
  background: rgba(246, 241, 232, 0.94);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-6px);
  transition: opacity 220ms var(--armel-ease), transform 220ms var(--armel-ease), visibility 0s 220ms;
}

.armel-hero__bar[data-collections-open] .armel-hero__panel {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: none;
  transition: opacity 220ms var(--armel-ease), transform 220ms var(--armel-ease);
}

.armel-hero__panel ul {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 28px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.armel-hero__panel a {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  color: inherit;
  text-decoration: none;
}

.armel-hero__panel a::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10px;
  height: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 420ms var(--armel-ease);
}

.armel-hero__nav a,
.armel-hero__locale,
.armel-hero__locale-select {
  color: inherit;
  text-decoration: none;
}

.armel-hero__mark a {
  display: inline-flex;
  text-decoration: none;
}

.armel-hero__tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: calc(50% - 84px);
}

.armel-hero__locale,
.armel-hero__locale-select {
  margin-inline-end: 6px;
  padding: 12px 4px;
  border: 0;
  background: transparent;
  font: inherit;
  appearance: none;
  cursor: pointer;
}

.armel-hero__locale-form {
  margin: 0;
}

.armel-hero__switch {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-inline-end: 2px;
  font-size: 13px;
  letter-spacing: 0.06em;
}

.armel-hero__switch--static {
  min-height: 44px;
  padding-inline: 4px;
}

.armel-hero__switch summary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 4px;
  list-style: none;
  cursor: pointer;
}

.armel-hero__switch summary::-webkit-details-marker {
  display: none;
}

.armel-hero__flag {
  display: block;
  width: 18px;
  height: 12px;
  box-shadow: 0 0 0 1px rgba(42, 18, 19, 0.16);
}

.armel-hero__chevron {
  width: 10px;
  height: 6px;
  transition: transform 200ms var(--armel-ease);
}

.armel-hero__switch[open] .armel-hero__chevron {
  transform: rotate(180deg);
}

.armel-hero__switch-panel {
  position: absolute;
  top: calc(100% - 6px);
  right: 0;
  z-index: 4;
  display: grid;
  min-width: 8.5rem;
  margin: 0;
  padding: 8px 6px 6px;
  background: #f6f1e8;
  box-shadow: 0 16px 40px rgba(42, 18, 19, 0.12);
}

.armel-hero__switch-panel form {
  display: grid;
  margin: 0;
}

.armel-hero__switch-panel form + form {
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px solid rgb(125 48 49 / 0.16);
}

.armel-hero__switch-label {
  margin: 0;
  padding: 4px 10px 2px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.armel-hero__switch-panel button {
  min-height: 40px;
  padding: 0 10px;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  letter-spacing: 0;
  text-align: left;
  cursor: pointer;
}

.armel-hero__switch-panel button[aria-current='true'] {
  font-weight: 600;
}

.armel-hero__icon-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  transition: transform 200ms var(--armel-ease), opacity 200ms ease;
}

.armel-hero__icon-btn svg {
  width: 20px;
  height: 20px;
}

.armel-hero__count {
  position: absolute;
  top: 6px;
  right: 2px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 8px;
  background: var(--armel-ink);
  color: #f6f1ec;
  font-size: 13px;
  font-weight: 600;
  line-height: 16px;
  font-variant-numeric: tabular-nums;
}

.armel-hero__toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-inline-start: -12px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.armel-hero__toggle-bars {
  position: relative;
  display: block;
  width: 20px;
  height: 10px;
}

.armel-hero__toggle-bars span {
  position: absolute;
  inset-inline: 0;
  height: 2px;
  background: currentColor;
  transition: transform 260ms var(--armel-ease);
}

.armel-hero__toggle-bars span:first-child { top: 0; }
.armel-hero__toggle-bars span:last-child { bottom: 0; }

.armel-hero__toggle[aria-expanded='true'] .armel-hero__toggle-bars span:first-child {
  transform: translateY(4px) rotate(45deg);
}

.armel-hero__toggle[aria-expanded='true'] .armel-hero__toggle-bars span:last-child {
  transform: translateY(-4px) rotate(-45deg);
}

.armel-hero__icon-btn:active,
.armel-hero__toggle:active,
.armel-hero__switch summary:active {
  transform: scale(0.97);
}

.armel-hero__bar :focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

/* Cream wash under the bar, darker veil toward the campaign type */
.armel-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(
      180deg,
      rgb(246 241 232 / 0.82) 0%,
      rgb(246 241 232 / 0.62) 8%,
      rgb(246 241 232 / 0.34) 18%,
      rgb(246 241 232 / 0.12) 30%,
      rgb(246 241 232 / 0) 44%
    ),
    linear-gradient(
      180deg,
      rgb(42 18 19 / 0) 48%,
      rgb(42 18 19 / 0.08) 68%,
      rgb(42 18 19 / 0.28) 86%,
      rgb(42 18 19 / 0.48) 100%
    );
}

/* ---------- campaign copy over the media ---------- */
.armel-hero__copy {
  position: absolute;
  z-index: 2;
  right: 0;
  bottom: clamp(48px, 12svh, 120px);
  left: 0;
  display: grid;
  justify-items: center;
  gap: clamp(22px, 3.2vw, 36px);
  width: min(920px, calc(100% - 2 * var(--armel-m)));
  margin-inline: auto;
  padding: 0;
  text-align: center;
  color: #f6f1e8;
}

html.a-js .armel-hero__copy {
  animation: armel-hero-copy-fade 980ms var(--armel-ease) 180ms both;
}

@keyframes armel-hero-copy-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.armel-hero__title {
  display: grid;
  gap: 0.35em;
  margin: 0;
  font-family: var(--a-display, var(--font-body--family), 'Montserrat', sans-serif);
  font-size: clamp(15px, 1.55vw + 0.55rem, 26px);
  font-weight: 500;
  font-size-adjust: var(--a-display-adjust, none);
  line-height: 1.35;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  text-wrap: balance;
}

.armel-hero__line {
  display: block;
}

.armel-hero__cta {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 30px;
  border: 1px solid rgb(246 241 232 / 0.92);
  background: rgb(246 241 232 / 0.92);
  color: #7d3031;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-decoration: none;
  text-transform: uppercase;
  transition: transform 200ms var(--armel-ease), background-color 220ms ease, color 220ms ease, border-color 220ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .armel-hero__cta:hover {
    background: transparent;
    color: #f6f1e8;
    border-color: rgb(246 241 232 / 0.92);
  }
}

.armel-hero__cta:active {
  transform: scale(0.97);
}

.armel-hero__cta:focus-visible {
  outline: 2px solid #f6f1e8;
  outline-offset: 3px;
}

.armel-hero__sig {
  position: absolute;
  z-index: 2;
  top: clamp(96px, 16svh, 160px);
  left: var(--armel-m);
  width: clamp(180px, 18vw, 280px);
  color: var(--armel-ink);
}

@media (hover: hover) and (pointer: fine) {
  .armel-hero__nav a:hover::after,
  .armel-hero__panel a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .armel-hero__icon-btn:hover,
  .armel-hero__mark a:hover,
  .armel-hero__locale-select:hover,
  .armel-hero__switch summary:hover {
    opacity: 0.6;
  }
  .armel-hero__switch-panel button:hover {
    background: rgba(125, 48, 49, 0.08);
    opacity: 1;
  }
}

/* ---------- phone ---------- */
@media screen and (max-width: 989px) {
  .armel-hero {
    min-height: 100svh;
    min-height: 100dvh;
  }

  .armel-hero__photo {
    object-position: 50% 0%;
    transform-origin: 50% 0;
    animation-name: armel-hero-drift-sm;
  }

  .armel-hero[data-armel-hero-video] .armel-hero__photo:not(.armel-hero__video) {
    animation: none;
  }

  @keyframes armel-hero-drift-sm {
    from { transform: scale(1.04); }
    to { transform: scale(1.1); }
  }

  .armel-hero__copy {
    bottom: max(40px, calc(env(safe-area-inset-bottom) + 28px));
    gap: 20px;
  }

  .armel-hero__title {
    font-size: clamp(13px, 2.8vw + 0.35rem, 17px);
    letter-spacing: 0.12em;
  }

  .armel-hero__cta {
    min-height: 46px;
    width: min(100%, 280px);
  }

  .armel-hero__sig {
    top: auto;
    bottom: max(24px, env(safe-area-inset-bottom));
    left: auto;
    right: var(--armel-m);
    width: 150px;
  }
}

@media screen and (max-width: 1360px) {
  .armel-hero__toggle {
    display: inline-flex;
  }

  /* Keep the bar a single compact row — the drawer must not expand it. */
  .armel-hero__bar {
    min-height: 56px;
    padding-block: max(8px, env(safe-area-inset-top)) 8px;
  }

  .armel-hero__start {
    max-width: none;
    flex: 0 0 auto;
  }

  .armel-hero__tools {
    max-width: none;
    flex: 0 0 auto;
    gap: 2px;
  }

  .armel-hero__panel {
    display: none;
  }

  .armel-hero__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 2;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 8px var(--armel-m) 20px;
    background: #f6f1e8;
    box-shadow: inset 0 1px rgb(125 48 49 / 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 240ms var(--armel-ease), transform 240ms var(--armel-ease), visibility 0s 240ms;
  }

  .armel-hero__nav[data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition: opacity 240ms var(--armel-ease), transform 240ms var(--armel-ease);
  }

  .armel-hero__nav a {
    min-height: 48px;
    font-size: 14px;
  }
}

/* ---------- sticky bar: transparent over the photo, white once you scroll ----------
   A white layer slides down behind the bar (Serapian-style), the logo settles a touch smaller.
   Transitions only switch on after the first frame, so a reload mid-page doesn't animate. */
.armel-hero-section {
  position: relative;
  z-index: 20; /* keeps the fixed bar above the sections that follow */
}

.armel-hero__bar {
  position: fixed;
  isolation: isolate;
}

.armel-hero__bar::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background: #ffffff;
  transform: translate3d(0, -101%, 0);
  pointer-events: none;
}

.armel-hero__bar[data-scrolled]::before {
  transform: none;
}

.armel-hero__bar[data-scrolled] {
  box-shadow: inset 0 -1px rgb(125 48 49 / 0.12);
}

.armel-hero__bar[data-scrolled] .armel-hero__mark {
  transform: translate(-50%, -50%) scale(0.86);
}

.armel-hero__bar[data-bar-ready] {
  transition: box-shadow 560ms var(--armel-ease);
}

.armel-hero__bar[data-bar-ready]::before {
  transition: transform 640ms var(--armel-ease);
}

.armel-hero__bar[data-bar-ready] .armel-hero__mark {
  transition: transform 640ms var(--armel-ease);
}

.armel-hero__bar[data-scrolled] .armel-hero__panel {
  background: #ffffff;
}

@media screen and (max-width: 1360px) {
  .armel-hero__bar[data-scrolled] .armel-hero__nav {
    background: #ffffff;
  }
}

@media (prefers-reduced-motion: reduce) {
  .armel-hero__photo,
  html.a-js .armel-hero__sig,
  html.a-js .armel-hero__copy {
    animation: none;
    transform: none;
    opacity: 1;
  }
  .armel-hero__video {
    display: none;
  }
  html.a-js .armel-hero__bar {
    animation: none;
    opacity: 1;
  }
  .armel-hero__bar,
  .armel-hero__bar::before,
  .armel-hero__mark {
    transition: none !important;
  }
  .armel-hero__nav,
  .armel-hero__nav a::after,
  .armel-hero__panel,
  .armel-hero__panel a::after,
  .armel-hero__toggle-bars span,
  .armel-hero__chevron {
    transition: none;
  }
}

/* ==========================================================================
   Mobile / tablet menu: a full-screen drawer that unrolls from the top.
   The bar stays on top of it; the burger turns into a cross.
   ========================================================================== */

.armel-drawer {
  display: none;
}

@media screen and (max-width: 1360px) {
  /* the old inline dropdown is replaced by the drawer */
  .armel-hero__nav {
    display: none !important;
  }

  .armel-drawer {
    position: fixed;
    inset: 0;
    z-index: -1; /* under the bar's own content, above the page */
    display: block;
    height: 100dvh;
    color: var(--armel-ink, #7d3031);
    background: #f6f1e8;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path 620ms cubic-bezier(0.76, 0, 0.24, 1),
      visibility 0s linear 620ms;
  }

  .armel-drawer[data-open] {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    pointer-events: auto;
    transition: clip-path 720ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .armel-drawer__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding:
      calc(max(8px, env(safe-area-inset-top)) + 56px + 32px)
      var(--armel-m, 20px)
      calc(24px + env(safe-area-inset-bottom));
  }

  /* bar while the menu is open: no white layer, no hairline */
  .armel-hero__bar[data-menu-open]::before {
    transform: translate3d(0, -101%, 0);
  }

  .armel-hero__bar[data-menu-open] {
    box-shadow: none;
  }

  /* ---------- links ---------- */
  .armel-drawer__links {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .armel-drawer__links > li {
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .armel-drawer[data-open] .armel-drawer__links > li {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) calc(240ms + var(--i, 0) * 70ms),
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1) calc(240ms + var(--i, 0) * 70ms);
  }

  .armel-drawer__link {
    position: relative;
    display: inline-block;
    padding: 4px 0;
    color: inherit;
    /* menu links: the text face in spaced capitals, so they read as navigation, not headlines */
    font-family: var(--font-body--family), 'Montserrat', sans-serif;
    font-size: clamp(20px, 5.6vw, 30px);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
  }

  .armel-drawer__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .armel-drawer__link[aria-current='page']::after,
  .armel-drawer__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .armel-drawer__sub {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 6px 0 14px;
    padding: 0;
    list-style: none;
  }

  .armel-drawer__sub a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.75;
  }

  /* ---------- feature card ---------- */
  .armel-drawer__feature {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 16px;
    margin-top: auto;
    padding: 10px 16px 10px 10px;
    color: inherit;
    background: #fff;
    text-decoration: none;
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .armel-drawer[data-open] .armel-drawer__feature {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) 520ms,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1) 520ms;
  }

  .armel-drawer__feature img {
    display: block;
    width: 96px;
    height: 72px;
    object-fit: cover;
  }

  .armel-drawer__feature-text {
    display: grid;
    gap: 4px;
  }

  .armel-drawer__feature-title {
    font-family: var(--a-display, inherit);
    font-size: 20px;
    font-weight: var(--a-display-weight, 500);
    line-height: 1.1;
  }

  .armel-drawer__feature-cta {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .armel-drawer__feature svg {
    width: 20px;
    height: 20px;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .armel-drawer__feature:active svg {
    transform: translateX(4px);
  }

  /* ---------- foot ---------- */
  .armel-drawer__foot {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 14px 16px;
    padding-top: 18px;
    box-shadow: inset 0 1px rgb(125 48 49 / 0.18);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .armel-drawer[data-open] .armel-drawer__foot {
    opacity: 1;
    transition: opacity 700ms ease 620ms;
  }

  .armel-drawer__switch .armel-hero__switch {
    margin: 0;
  }

  .armel-drawer__mail {
    justify-self: end;
    color: inherit;
    font-size: 13px;
    text-decoration: none;
  }

  .armel-drawer__sig {
    grid-column: 1 / -1;
    display: block;
    width: 170px;
    aspect-ratio: 1524 / 274;
    background: currentColor;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
}

/* phones: the currency/language switch (and the account icon) live in the drawer, so the logo has room */
@media screen and (max-width: 989px) {
  .armel-hero__tools > .armel-hero__switch {
    display: none;
  }
}

@media screen and (max-width: 520px) {
  .armel-hero__tools > a.armel-hero__icon-btn[href*='account'] {
    display: none;
  }
}

@media screen and (max-width: 1360px) {
  .armel-drawer__account {
    color: inherit;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .armel-drawer__account--end {
    justify-self: end;
  }
}

@media (hover: hover) and (pointer: fine) and (max-width: 1360px) {
  .armel-drawer__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .armel-drawer__sub a:hover {
    opacity: 1;
  }
  .armel-drawer__feature:hover svg {
    transform: translateX(4px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .armel-drawer,
  .armel-drawer[data-open],
  .armel-drawer__links > li,
  .armel-drawer__feature,
  .armel-drawer__foot {
    transition: none !important;
    transform: none !important;
  }
}

/* ---------- menu on burgundy: light text, silver logo ---------- */
.armel-hero__mark a {
  position: relative;
}

.armel-hero__logo--silver {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0;
  pointer-events: none;
  transition: opacity 400ms ease;
}

@media screen and (max-width: 1360px) {
  .armel-drawer {
    --armel-drawer-ink: #f3eee8;
    color: var(--armel-drawer-ink);
    background: #7d3031;
  }

  .armel-hero__bar[data-menu-open] {
    color: #f3eee8;
  }

  .armel-hero__bar .armel-hero__logo:not(.armel-hero__logo--silver) {
    transition: opacity 400ms ease;
  }

  .armel-hero__bar[data-menu-open] .armel-hero__logo:not(.armel-hero__logo--silver) {
    opacity: 0;
  }

  .armel-hero__bar[data-menu-open] .armel-hero__logo--silver {
    opacity: 1;
  }

  .armel-hero__bar[data-menu-open] .armel-hero__count {
    background: #f3eee8;
    color: #7d3031;
  }

  .armel-drawer__feature {
    color: #7d3031;
    background: #f3eee8;
  }

  .armel-drawer__foot {
    box-shadow: inset 0 1px rgb(243 238 232 / 0.25);
  }

  .armel-drawer__switch,
  .armel-drawer__switch * {
    color: inherit;
  }
}
